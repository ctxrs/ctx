    "//crates/ctx-cli:loc_check_inputs",
    "//crates/ctx-history-capture:loc_check_inputs",
    "//crates/ctx-history-core:loc_check_inputs",
    "//crates/ctx-history-index:loc_check_inputs",
    "//crates/ctx-history-refresh:loc_check_inputs",
