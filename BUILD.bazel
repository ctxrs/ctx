LOC_CHECK_DATA = LOC_CHECK_SOURCE_DATA + [
    ":loc_check_source_manifest",
    "scripts/check-loc-policy-v2.json",
    "@ctx_scc_linux_x86_64//:scc",
]

# Keep the direct-checkout and Bazel package audits on the exact same source
# surface. The checker owns the path list; these filegroups make those paths
# available in the sandboxed runfiles tree.
RELEASE_PACKAGE_AUDIT_DATA = NON_RUST_GATE_DATA + [
    "//crates/ctx-cli:cargo_package_data",
    "//crates/ctx-history-capture:cargo_package_data",
    "//crates/ctx-history-core:cargo_package_data",
    "//crates/ctx-history-index:cargo_package_data",
    "//crates/ctx-history-refresh:cargo_package_data",
]

REAL_HARNESS_DATA = NON_RUST_GATE_DATA + ["//crates/ctx-cli:ctx"]

