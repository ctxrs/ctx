    ".bazelignore",
    ".bazelrc",
    ".bazelversion",
    ".buildkite/**",
    ".gitignore",
    "BUILD.bazel",
    "Cargo.lock",
    "Cargo.toml",
    "Cross.toml",
    "LICENSE",
    "MODULE.bazel",
    "README.md",
    "SECURITY.md",
    "contracts/**",
    "docs/**",
    "plugins/**",
    "protocol/**",
    "scripts/**",
    "sdks/**",
    "skills/**",
    "tests/**",
]) + [
    "//sdks/go:repository_gate_data",
    "//sdks/go/examples/dogfood:repository_gate_data",
]

