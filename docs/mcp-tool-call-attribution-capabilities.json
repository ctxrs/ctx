  "status_definitions": {
    "exact": "ctx may publish mcp_tool_call only for a uniquely linked canonical terminal record carrying the authoritative raw server alias and advertised tool name within this exact tuple.",
    "not-qualified": "The tuple was evaluated and fails the exact-attribution evidence rule; general local history import may still be Supported.",
    "excluded": "The candidate route is outside ctx's local-only history import boundary."
  },
  "failure_reason_definitions": {
    "lossy_composite": "Persistence sanitizes, normalizes, truncates, flattens, or otherwise combines identity fields non-injectively.",
    "exact_pair_transient_or_config": "The exact pair exists only in transient runtime, configuration, discovery, or provider-overridable state rather than authoritative call-local terminal evidence.",
    "no_server_field": "The durable call record does not retain an authoritative MCP server alias.",
    "no_unique_terminal_link": "The durable format cannot link the exact invocation to one canonical terminal record without order, FIFO, timing, or name inference.",
    "route_mismatch": "A richer producer route exists or existed, but it is not the route imported by this tuple or it loses identity before this boundary.",
    "writer_version_unproven": "The admitted format has no public first-party writer or durable version boundary proving the required fields and lifecycle."
  },
  "exclusion_reason_definitions": {
    "outside_local_only_boundary": "The evidence source is a hosted remote trace rather than local agent history."
  },
