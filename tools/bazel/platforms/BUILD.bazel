load("//tools/bazel:gates.bzl", "loc_check_inputs")

package(default_visibility = ["//visibility:public"])

loc_check_inputs(name = "loc_check_inputs")

constraint_setting(
    name = "windows_abi",
    default_constraint_value = ":windows_msvc",
)

constraint_value(
    name = "windows_msvc",
    constraint_setting = ":windows_abi",
)

constraint_value(
    name = "windows_gnu",
    constraint_setting = ":windows_abi",
)

platform(
    name = "release_linux_x64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

platform(
    name = "release_linux_arm64",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
    ],
)

platform(
    name = "release_macos_arm64",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:osx",
    ],
)

platform(
    name = "release_macos_x64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:osx",
    ],
)

platform(
    name = "release_windows_x64_gnu",
    constraint_values = [
        ":windows_gnu",
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
    ],
)

platform(
    name = "release_freebsd_x64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:freebsd",
    ],
)

# crate_universe's platform template is routed through this package so the
# contracted GNU ABI can be represented without conflating it with MSVC.
alias(
    name = "aarch64-apple-darwin",
    actual = "@rules_rust//rust/platform:aarch64-apple-darwin",
)

alias(
    name = "aarch64-unknown-linux-gnu",
    actual = "@rules_rust//rust/platform:aarch64-unknown-linux-gnu",
)

alias(
    name = "wasm32-unknown-unknown",
    actual = "@rules_rust//rust/platform:wasm32-unknown-unknown",
)

alias(
    name = "wasm32-wasip1",
    actual = "@rules_rust//rust/platform:wasm32-wasip1",
)

alias(
    name = "x86_64-apple-darwin",
    actual = "@rules_rust//rust/platform:x86_64-apple-darwin",
)

config_setting(
    name = "x86_64-pc-windows-gnu",
    constraint_values = [
        ":windows_gnu",
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
    ],
)

config_setting(
    name = "x86_64-pc-windows-msvc",
    constraint_values = [
        ":windows_msvc",
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
    ],
)

alias(
    name = "x86_64-unknown-freebsd",
    actual = "@rules_rust//rust/platform:x86_64-unknown-freebsd",
)

alias(
    name = "x86_64-unknown-linux-gnu",
    actual = "@rules_rust//rust/platform:x86_64-unknown-linux-gnu",
)

alias(
    name = "x86_64-unknown-nixos-gnu",
    actual = "@rules_rust//rust/platform:x86_64-unknown-nixos-gnu",
)
