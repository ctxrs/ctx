load(":cargo_vendor_sources.bzl", "cargo_vendor_sources", "rust_toolchain_file")
load(":mold_toolchain.bzl", "mold_toolchain_files")

exports_files([
    "check-cli-build-cfg.sh",
    "check_rust_target_inventory.py",
    "check_rust_toolchain_pins.py",
    "check_rust_toolchain_pins_test.py",
    "select_affected_tests.py",
    "select_affected_tests_test.py",
    "rust-target-inventory.json",
])

package(default_visibility = ["//visibility:public"])

rust_toolchain_file(
    name = "pinned_cargo",
    tool = "cargo",
)

rust_toolchain_file(
    name = "pinned_rustc",
    tool = "rustc",
)

cargo_vendor_sources(
    name = "sdk_cargo_vendor_sources",
    crates = [
        "@crates//:serde-1.0.228",
        "@crates//:serde_json-1.0.150",
        "@crates//:tempfile-3.27.0",
        "@crates//:thiserror-1.0.69",
    ],
)

mold_toolchain_files(
    name = "mold_toolchain",
    mold = "@ctx_mold//:bin/ld.mold",
)
