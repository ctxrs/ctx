#!/usr/bin/env bash
set -euo pipefail
umask 077

script_repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
invocation_repo_root="$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null || true)"
if [[ -n "${CTX_BAZEL_WORKSPACE:-}" && -f "${CTX_BAZEL_WORKSPACE}/MODULE.bazel" ]]; then
  repo_root="$(cd "${CTX_BAZEL_WORKSPACE}" && pwd -P)"
elif [[ -n "${BUILD_WORKSPACE_DIRECTORY:-}" && -f "${BUILD_WORKSPACE_DIRECTORY}/MODULE.bazel" ]]; then
  repo_root="$(cd "${BUILD_WORKSPACE_DIRECTORY}" && pwd -P)"
elif [[ -n "${invocation_repo_root}" && -f "${invocation_repo_root}/MODULE.bazel" ]]; then
  repo_root="$(cd "${invocation_repo_root}" && pwd -P)"
else
  repo_root="${script_repo_root}"
fi
export CTX_REPO_ROOT="${repo_root}"

if (( "$#" == 0 )); then
  set -- help
fi
command_name="$1"

host_build_governor=""
host_build_governed=0
host_build_governor_active=0
if [[ "${CTX_HOST_BUILD_GOVERNOR_ACTIVE:-0}" == "1" ]]; then
  lease_id="${CTX_BUILD_GOVERNOR_LEASE_ID:-}"
  lease_class="${CTX_BUILD_GOVERNOR_LEASE_CLASS:-}"
  if [[ ! "$lease_id" =~ ^[0-9a-f]{32}$ || ! "$lease_class" =~ ^(heavy|light|remote)$ ]] ||
    ! grep -Fq -- "/ctx-build-lease-${lease_id}.service" /proc/self/cgroup; then
    printf 'CTX host build governor active marker is not backed by the current lease cgroup\n' >&2
    exit 125
  fi
  host_build_governor_active=1
fi
case "${command_name}" in
  analyze-profile|aquery|canonicalize-flags|cquery|dump|help|info|license|query|shutdown|version)
    ;;
  *)
    if (( host_build_governor_active == 0 )); then
      if [[ -v CTX_HOST_BUILD_GOVERNOR ]]; then
        host_build_governor="${CTX_HOST_BUILD_GOVERNOR}"
      else
        config_home="${XDG_CONFIG_HOME:-${HOME:-}/.config}"
        governor_hook="${config_home}/ctx/build-governor"
        if [[ -e "${governor_hook}" || -L "${governor_hook}" ]]; then
          host_build_governor="${governor_hook}"
        fi
      fi
      if [[ -v CTX_HOST_BUILD_GOVERNOR && -z "${host_build_governor}" ]]; then
        printf 'configured CTX host build governor must not be empty\n' >&2
        exit 125
      fi
      if [[ -n "${host_build_governor}" ]]; then
        if [[ "${host_build_governor}" != /* || ! -x "${host_build_governor}" ]]; then
          printf 'configured CTX host build governor must be an absolute executable: %s\n' \
            "${host_build_governor}" >&2
          exit 125
        fi
        host_build_governed=1
        if [[ -z "${BAZEL_JOBS:-}" && -z "${CTX_BAZEL_JOBS:-}" ]]; then
          export CTX_BAZEL_JOBS=16
        fi
        if [[ -z "${BAZEL_LOCAL_CPU_RESOURCES:-}" && -z "${CTX_BAZEL_LOCAL_CPU_RESOURCES:-}" ]]; then
          export CTX_BAZEL_LOCAL_CPU_RESOURCES=16
        fi
        if [[ -z "${BAZEL_LOCAL_RAM_RESOURCES:-}" && -z "${CTX_BAZEL_LOCAL_RAM_RESOURCES:-}" ]]; then
          export CTX_BAZEL_LOCAL_RAM_RESOURCES=49152
        fi
      fi
    fi
    ;;
esac
# shellcheck source=scripts/ci-common.sh
source "${script_repo_root}/scripts/ci-common.sh"

ctx_init_resource_env
cache_root="$(ctx_bazel_cache_root)"
bazel_version="$(ctx_bazel_version)"
export USE_BAZEL_VERSION="${bazel_version}"
version_root="${cache_root}/bazel-${bazel_version}"

if command -v sha256sum >/dev/null 2>&1; then
  workspace_key="$(printf '%s' "${repo_root}" | sha256sum | cut -c1-20)"
elif command -v shasum >/dev/null 2>&1; then
  workspace_key="$(printf '%s' "${repo_root}" | shasum -a 256 | cut -c1-20)"
elif command -v openssl >/dev/null 2>&1; then
  workspace_key="$(printf '%s' "${repo_root}" | openssl dgst -sha256 | awk '{ print substr($NF, 1, 20) }')"
else
  workspace_key="$(printf '%s' "${repo_root}" | cksum | awk '{ print $1 }')"
fi

output_root="${BAZEL_OUTPUT_USER_ROOT:-${cache_root}/output-roots/bazel-${bazel_version}/${workspace_key}}"
repository_cache="${CTX_BAZEL_REPOSITORY_CACHE:-${version_root}/repository-cache}"
action_cache="${CTX_BAZEL_ACTION_CACHE:-${version_root}/action-test-cache}"
sandbox_base="${CTX_BAZEL_SANDBOX_BASE:-${version_root}/sandboxes/${workspace_key}}"
sandbox_base_is_default=0
if [[ -z "${CTX_BAZEL_SANDBOX_BASE:-}" ]]; then
  sandbox_base_is_default=1
fi
disk_cache_max_size="${CTX_BAZEL_DISK_CACHE_MAX_SIZE:-100G}"
disk_cache_max_age="${CTX_BAZEL_DISK_CACHE_MAX_AGE:-30d}"
export BAZELISK_HOME="${BAZELISK_HOME:-${cache_root}/bazelisk}"

mkdir -p "${BAZELISK_HOME}" "${output_root}" "${repository_cache}" "${action_cache}" "${sandbox_base}"

if [[ -n "${CTX_BAZEL_BIN:-}" ]]; then
  bazel_bin="${CTX_BAZEL_BIN}"
elif [[ -n "${BAZEL:-}" ]]; then
  bazel_bin="${BAZEL}"
elif command -v bazelisk >/dev/null 2>&1; then
  bazel_bin="$(command -v bazelisk)"
elif command -v bazel >/dev/null 2>&1; then
  bazel_bin="$(command -v bazel)"
elif [[ -x "${repo_root}/target/tool-cache/bazelisk/bin/bazelisk" ]]; then
  bazel_bin="${repo_root}/target/tool-cache/bazelisk/bin/bazelisk"
else
  printf 'bazelisk or bazel is required (or set BAZEL)\n' >&2
  exit 127
fi

version_output="$("${bazel_bin}" --version 2>/dev/null || true)"
actual_bazel_version="${version_output#bazel }"
if [[ "${version_output}" != "bazel ${bazel_version}" ]]; then
  printf 'Bazel version mismatch: expected %s, got %s\n' \
    "${bazel_version}" \
    "${actual_bazel_version:-unknown}" >&2
  exit 64
fi

shift

run_bazel() {
  if (( host_build_governed == 1 )); then
    exec "${host_build_governor}" bazel "${command_name}" -- "$@"
  fi
  exec "$@"
}

printf 'ctx bazel: jobs=%s cpu=%s ram_mb=%s test_jobs=%s rust_threads=%s cache=%s\n' \
  "${BAZEL_JOBS}" \
  "${BAZEL_LOCAL_CPU_RESOURCES}" \
  "${BAZEL_LOCAL_RAM_RESOURCES}" \
  "${BAZEL_LOCAL_TEST_JOBS}" \
  "${RUST_TEST_THREADS}" \
  "${version_root}" >&2

cd "${repo_root}"
case "${command_name}" in
  shutdown)
    "${bazel_bin}" \
      --output_user_root="${output_root}" \
      --max_idle_secs="${CTX_BAZEL_MAX_IDLE_SECS:-600}" \
      shutdown "$@"
    if (( sandbox_base_is_default == 1 )) &&
      [[ "${sandbox_base}" == "${version_root}/sandboxes/${workspace_key}" ]]; then
      rm -rf -- "${sandbox_base}"
    fi
    ;;
  analyze-profile|canonicalize-flags|clean|dump|help|info|license|version)
    run_bazel "${bazel_bin}" \
      --output_user_root="${output_root}" \
      --max_idle_secs="${CTX_BAZEL_MAX_IDLE_SECS:-600}" \
      "${command_name}" "$@"
    ;;
  *)
    shared_args=(
      --repository_cache="${repository_cache}"
      --disk_cache="${action_cache}"
      --experimental_disk_cache_gc_max_size="${disk_cache_max_size}"
      --experimental_disk_cache_gc_max_age="${disk_cache_max_age}"
    )
    case "${command_name}" in
      build|coverage|run|test)
        shared_args+=(
          --jobs="${BAZEL_JOBS}"
          --local_resources="cpu=${BAZEL_LOCAL_CPU_RESOURCES}"
          --local_resources="memory=${BAZEL_LOCAL_RAM_RESOURCES}"
          --sandbox_base="${sandbox_base}"
        )
        ;;
    esac
    case "${command_name}" in
      coverage|test)
        shared_args+=(
          --local_test_jobs="${BAZEL_LOCAL_TEST_JOBS}"
          --test_env="RUST_TEST_THREADS=${RUST_TEST_THREADS}"
        )
        ;;
    esac
    run_bazel "${bazel_bin}" \
      --output_user_root="${output_root}" \
      --max_idle_secs="${CTX_BAZEL_MAX_IDLE_SECS:-600}" \
      "${command_name}" "${shared_args[@]}" "$@"
    ;;
esac
