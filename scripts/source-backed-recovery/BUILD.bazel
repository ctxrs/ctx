load("@rules_cc//cc:defs.bzl", "cc_binary")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "local_fault_harness_sources",
    srcs = [
        "fault_shim.c",
        "run-bounded-enospc-test.sh",
        "run-linux-fault-tests.sh",
    ],
    tags = [
        "manual",
        "source-backed-recovery",
    ],
)

cc_binary(
    name = "libctx_source_recovery_fault.so",
    srcs = ["fault_shim.c"],
    copts = [
        "-std=c11",
        "-O2",
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    linkopts = ["-ldl"],
    linkshared = True,
    linkstatic = True,
    tags = [
        "fault-injection",
        "linux-only",
        "source-backed-recovery",
    ],
    target_compatible_with = ["@platforms//os:linux"],
)

SOURCE_BACKED_RECOVERY_FAULT_RUNFILES = [
    ":libctx_source_recovery_fault.so",
    "//crates/ctx-history-index:source_backed_recovery_tests",
]

SOURCE_BACKED_RECOVERY_FAULT_TAGS = [
    "fault-injection",
    "linux-only",
    "release-gate",
    "source-backed-recovery",
]

# Each leaf target names one ignored Rust test so a failed fault point has an
# exact Bazel reproduction. The runner receives only declared runfiles and
# confines temporary state to Bazel's private test directory.
sh_test(
    name = "exact_manifest_and_tantivy_swap_process_death_matrix",
    srcs = ["run-bazel-linux-fault-test.sh"],
    args = [
        "$(rootpath //crates/ctx-history-index:source_backed_recovery_tests)",
        "$(rootpath :libctx_source_recovery_fault.so)",
        "exact_manifest_and_tantivy_swap_process_death_matrix",
    ],
    data = SOURCE_BACKED_RECOVERY_FAULT_RUNFILES,
    size = "medium",
    tags = SOURCE_BACKED_RECOVERY_FAULT_TAGS,
    target_compatible_with = ["@platforms//os:linux"],
)

sh_test(
    name = "retry_after_pre_meta_crash_reclaims_tantivy_candidate_files",
    srcs = ["run-bazel-linux-fault-test.sh"],
    args = [
        "$(rootpath //crates/ctx-history-index:source_backed_recovery_tests)",
        "$(rootpath :libctx_source_recovery_fault.so)",
        "retry_after_pre_meta_crash_reclaims_tantivy_candidate_files",
    ],
    data = SOURCE_BACKED_RECOVERY_FAULT_RUNFILES,
    size = "medium",
    tags = SOURCE_BACKED_RECOVERY_FAULT_TAGS,
    target_compatible_with = ["@platforms//os:linux"],
)

sh_test(
    name = "injected_enospc_and_write_sync_failures_preserve_previous_generation",
    srcs = ["run-bazel-linux-fault-test.sh"],
    args = [
        "$(rootpath //crates/ctx-history-index:source_backed_recovery_tests)",
        "$(rootpath :libctx_source_recovery_fault.so)",
        "injected_enospc_and_write_sync_failures_preserve_previous_generation",
    ],
    data = SOURCE_BACKED_RECOVERY_FAULT_RUNFILES,
    size = "medium",
    tags = SOURCE_BACKED_RECOVERY_FAULT_TAGS,
    target_compatible_with = ["@platforms//os:linux"],
)

sh_test(
    name = "actual_bounded_filesystem_enospc_preserves_previous_generation",
    srcs = ["run-bounded-enospc-test.sh"],
    args = [
        "$(rootpath //crates/ctx-history-index:source_backed_recovery_tests)",
    ],
    data = ["//crates/ctx-history-index:source_backed_recovery_tests"],
    size = "medium",
    tags = [
        "local",
        "manual",
        "no-sandbox",
        "real-enospc",
        "requires-sudo",
        "source-backed-recovery",
    ],
    target_compatible_with = ["@platforms//os:linux"],
)

sh_test(
    name = "writer_reopen_reclaims_abandoned_atomic_write_files",
    srcs = ["run-bazel-linux-fault-test.sh"],
    args = [
        "$(rootpath //crates/ctx-history-index:source_backed_recovery_tests)",
        "$(rootpath :libctx_source_recovery_fault.so)",
        "writer_reopen_reclaims_abandoned_atomic_write_files",
    ],
    data = SOURCE_BACKED_RECOVERY_FAULT_RUNFILES,
    size = "medium",
    tags = SOURCE_BACKED_RECOVERY_FAULT_TAGS,
    target_compatible_with = ["@platforms//os:linux"],
)

sh_test(
    name = "retry_resynchronizes_a_reused_manifest_before_meta_publication",
    srcs = ["run-bazel-linux-fault-test.sh"],
    args = [
        "$(rootpath //crates/ctx-history-index:source_backed_recovery_tests)",
        "$(rootpath :libctx_source_recovery_fault.so)",
        "retry_resynchronizes_a_reused_manifest_before_meta_publication",
    ],
    data = SOURCE_BACKED_RECOVERY_FAULT_RUNFILES,
    size = "medium",
    tags = SOURCE_BACKED_RECOVERY_FAULT_TAGS,
    target_compatible_with = ["@platforms//os:linux"],
)

test_suite(
    name = "fault_qualification",
    tests = [
        ":exact_manifest_and_tantivy_swap_process_death_matrix",
        ":injected_enospc_and_write_sync_failures_preserve_previous_generation",
        ":retry_after_pre_meta_crash_reclaims_tantivy_candidate_files",
        ":retry_resynchronizes_a_reused_manifest_before_meta_publication",
        ":writer_reopen_reclaims_abandoned_atomic_write_files",
    ],
)
