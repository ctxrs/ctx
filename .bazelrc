common --enable_bzlmod
common --show_timestamps
common --workspace_status_command=scripts/bazel/workspace-status.sh

startup --max_idle_secs=600

build --announce_rc
build --verbose_failures
# Java-backed graph tooling must not depend on a workstation system JDK.
build --java_runtime_version=remotejdk_21
test --cache_test_results=auto
test --test_output=errors

# Fast local Linux iteration: stable fastbuild key, no Rust debug info, and the
# content-pinned mold input declared in MODULE.bazel.
build:dev-linux --compilation_mode=fastbuild
build:dev-linux --define=ctx_dev_linux=true
build:dev-linux --@rules_rust//rust/settings:extra_rustc_flag=-Cdebuginfo=0
test:dev-linux --test_output=errors

# Intentional debugger builds use a separate key and the platform linker.
build:dev-debug --compilation_mode=dbg
build:dev-debug --@rules_rust//rust/settings:extra_rustc_flag=-Cdebuginfo=2

# Routine tests, hosted CI, and release construction remain distinct cache
# keys. The repository wrapper supplies adaptive worker resource sizing.
build:test --compilation_mode=fastbuild
build:test --stamp=false
test:test --flaky_test_attempts=1
test:test --test_summary=detailed
test:test --test_timeout=300,900,1800,3600

build:ci --compilation_mode=fastbuild
build:ci --stamp=false
build:ci --color=yes
build:ci --curses=no
test:ci --build_tests_only
test:ci --test_env=BUILDKITE
test:ci --test_env=BUILDKITE_BUILD_ID
test:ci --test_env=CI
test:ci --test_env=GITHUB_ACTIONS
test:ci --test_output=errors
test:ci --test_summary=detailed
test:ci --test_timeout=300,900,1800,3600

build:release --compilation_mode=opt
build:release --stamp=true
# Bazel's generic strip setting does not propagate Cargo's release-profile
# policy into rules_rust link actions. Keep both settings: --strip covers
# native rules, while rustc owns symbol stripping for every Rust release binary.
build:release --strip=always
build:release --@rules_rust//rust/settings:extra_rustc_flag=-Cstrip=symbols
# Freeze the Apple deployment policy inside the release action environment so
# native SDK upgrades cannot silently raise the minimum supported macOS.
build:release --action_env=MACOSX_DEPLOYMENT_TARGET=13.0

build:lint --aspects=@rules_rust//rust:defs.bzl%rust_clippy_aspect
build:lint --output_groups=+clippy_checks
build:lint --@rules_rust//rust/settings:clippy_flag=-Dwarnings
