{
  "name": "docs-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "generate:content": "node node_modules/tsx/dist/cli.mjs scripts/build-content.ts",
    "dev": "pnpm generate:content && vite",
    "build": "pnpm generate:content && vite build && tsx scripts/prerender.ts",
    "deploy": "pnpm build && wrangler pages deploy dist --project-name ctx-site --branch main",
    "build:ade-archive": ": \"${CTX_DOCS_CONTENT_ROOT:?Set CTX_DOCS_CONTENT_ROOT to the archive content root}\" && VITE_CTX_INSTALL_COMMAND='curl -fsSL https://ade.ctx.rs/install | sh' VITE_CTX_SITE_ORIGIN=https://ade.ctx.rs pnpm build",
    "deploy:ade-archive": "pnpm build:ade-archive && wrangler pages deploy dist --project-name ctx-ade-site --branch main",
    "preview": "vite preview",
    "test": "pnpm generate:content && node node_modules/vitest/vitest.mjs run",
    "visual:parity": "tsx scripts/visual-parity.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": []
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@types/node": "^24.12.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "mdast-util-to-string": "^4.0.0",
    "pixelmatch": "^7.1.0",
    "playwright": "^1.56.1",
    "pngjs": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "shiki": "^4.0.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.136.0"
  }
}
