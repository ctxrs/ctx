load("@crates//:defs.bzl", "aliases", "all_crate_deps", "crate_edition")
load("@rules_rust//rust:defs.bzl", "rust_library")
load("//:rust_sources.bzl", "RUST_PROD_SRC_EXCLUDES")
load("//tools/bazel:ctx_rust.bzl", "ctx_rust_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "BUILD.bazel",
    "Cargo.toml",
])

filegroup(
    name = "cargo_package_data",
    srcs = glob(["**"], exclude = ["BUILD.bazel"]),
)

filegroup(
    name = "provider_architecture_sources",
    srcs = glob(["src/**/*.rs"], exclude = RUST_PROD_SRC_EXCLUDES),
)

COMMON_RUSTC_ENV = {
    "CARGO_MANIFEST_DIR": "crates/ctx-history-providers-sqlite-logical",
}

RUST_SRCS = glob(["src/**/*.rs"])
PROD_SRCS = glob(["src/**/*.rs"], exclude = RUST_PROD_SRC_EXCLUDES)

LOGICAL_SQLITE_PROVIDER_DEPS = [
    "//crates/ctx-history-capture-model:lib",
    "//crates/ctx-history-capture-runtime:lib",
    "//crates/ctx-history-core:lib",
    "//crates/ctx-history-source-io:lib",
    "//crates/ctx-history-source-sqlite:lib",
]

LOGICAL_SQLITE_PROVIDER_TEST_DEPS = [
    "//crates/ctx-history-capture-model:lib",
    "//crates/ctx-history-capture-runtime:lib",
    "//crates/ctx-history-core:lib",
    "//crates/ctx-history-source-io:test_support_lib",
    "//crates/ctx-history-source-sqlite:test_support_lib",
]

rust_library(
    name = "lib",
    srcs = PROD_SRCS,
    crate_name = "ctx_history_providers_sqlite_logical",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    aliases = aliases(),
    deps = all_crate_deps(normal = True) + LOGICAL_SQLITE_PROVIDER_DEPS,
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_env = COMMON_RUSTC_ENV,
)

ctx_rust_test(
    name = "unit_tests",
    srcs = RUST_SRCS,
    crate_name = "ctx_history_providers_sqlite_logical",
    crate_root = "src/lib.rs",
    data = ["//:public_test_fixtures"],
    edition = crate_edition(),
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = all_crate_deps(normal = True, normal_dev = True) + LOGICAL_SQLITE_PROVIDER_TEST_DEPS,
    proc_macro_deps = all_crate_deps(proc_macro = True, proc_macro_dev = True),
    rustc_env = COMMON_RUSTC_ENV,
)

ctx_rust_test(
    name = "capture_facade_replay_tests",
    srcs = ["tests/bazel/capture_facade_replay.rs"],
    crate_name = "logical_sqlite_capture_facade_replay",
    crate_root = "tests/bazel/capture_facade_replay.rs",
    edition = crate_edition(),
    deps = [
        "@crates//:rmpv-1.3.1",
        "@crates//:rusqlite-0.32.1",
        "@crates//:serde_json-1.0.150",
        "@crates//:tempfile-3.27.0",
        "//crates/ctx-history-capture:lib",
        "//crates/ctx-history-capture-composition:lib",
        "//crates/ctx-history-capture-runtime:lib",
        "//crates/ctx-history-core:lib",
        "//crates/ctx-history-index:lib",
        "//crates/ctx-history-providers-sqlite-logical:lib",
    ],
)
