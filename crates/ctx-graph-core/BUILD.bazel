load("@crates//:defs.bzl", "aliases", "all_crate_deps", "crate_edition")
load("@rules_rust//cargo:defs.bzl", "cargo_toml_env_vars")
load("//:rust_sources.bzl", "RUST_PROD_SRC_EXCLUDES")
load("//tools/bazel:ctx_rust.bzl", "ctx_rust_test")
load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

alias(
    name = "ctx-graph-core",
    actual = ":lib",
)

exports_files(["BUILD.bazel", "Cargo.toml", "LICENSE-GRAF"])

filegroup(
    name = "cargo_package_data",
    srcs = glob(["**"], exclude = ["BUILD.bazel"]),
)

COMMON_RUSTC_ENV = {
    "CARGO_MANIFEST_DIR": "crates/ctx-graph-core",
}

cargo_toml_env_vars(
    name = "cargo_toml_env_vars",
    src = "Cargo.toml",
    workspace = "//:Cargo.toml",
)

RUST_SRCS = glob(["src/**/*.rs"])
PROD_SRCS = glob(["src/**/*.rs"], exclude = RUST_PROD_SRC_EXCLUDES)

rust_library(
    name = "lib",
    srcs = PROD_SRCS,
    crate_name = "ctx_graph_core",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    aliases = aliases(),
    compile_data = glob(["src/assets/**"]),
    deps = ["//crates/ctx-graph-types", "//crates/ctx-graph-ingest", "//crates/ctx-graph-python", "//crates/ctx-graph-languages", "//crates/ctx-graph-storage"] + all_crate_deps(normal = True),
    rustc_env = COMMON_RUSTC_ENV,
)

ctx_rust_test(
    name = "unit_tests",
    srcs = RUST_SRCS,
    crate_name = "ctx_graph_core",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    compile_data = glob(["src/assets/**"]),
    deps = ["//crates/ctx-graph-types", "//crates/ctx-graph-ingest", "//crates/ctx-graph-python", "//crates/ctx-graph-languages", "//crates/ctx-graph-storage"] + all_crate_deps(normal = True, normal_dev = True),
    rustc_env = COMMON_RUSTC_ENV,
)
