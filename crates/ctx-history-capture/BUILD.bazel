load("@crates//:defs.bzl", "aliases", "all_crate_deps", "crate_edition")
load("@rules_rust//rust:defs.bzl", "rust_library")
load("//:rust_sources.bzl", "RUST_PROD_SRC_EXCLUDES")
load("//tools/bazel:ctx_rust.bzl", "ctx_rust_binary", "ctx_rust_test")
load("//tools/bazel:gates.bzl", "loc_check_inputs")

package(default_visibility = ["//visibility:public"])

loc_check_inputs(name = "loc_check_inputs")

filegroup(
    name = "cargo_package_data",
    srcs = glob(["**"], exclude = ["BUILD.bazel"]),
)

filegroup(
    name = "provider_architecture_sources",
    srcs = glob(
        [
            "src/provider/**/*.rs",
            "src/provider_sources/**/*.rs",
        ],
        exclude = RUST_PROD_SRC_EXCLUDES,
    ),
)

COMMON_RUSTC_ENV = {
    "CARGO_MANIFEST_DIR": "crates/ctx-history-capture",
}

RUST_SRCS = glob(["src/**/*.rs"])

PROD_SRCS = glob(
    ["src/**/*.rs"],
    exclude = RUST_PROD_SRC_EXCLUDES,
)

CTX_HISTORY_CAPTURE_DEPS = [
    "//crates/ctx-history-core:lib",
    "//crates/ctx-history-index:lib",
    "//crates/ctx-pro-host-protocol:lib",
]

rust_library(
    name = "lib",
    srcs = PROD_SRCS,
    crate_name = "ctx_history_capture",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    aliases = aliases(),
    deps = all_crate_deps(normal = True) + CTX_HISTORY_CAPTURE_DEPS,
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_env = COMMON_RUSTC_ENV,
)

ctx_rust_binary(
    name = "codex_nativepath_qualification",
    srcs = ["qualification/codex_nativepath.rs"],
    crate_name = "codex_nativepath_qualification",
    crate_root = "qualification/codex_nativepath.rs",
    edition = crate_edition(),
    aliases = aliases(),
    deps = all_crate_deps(normal = True) + [
        ":lib",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True),
    tags = [
        "local",
        "manual",
        "qualification",
    ],
    visibility = ["//visibility:private"],
)

ctx_rust_test(
    name = "codex_nativepath_qualification_tests",
    srcs = ["qualification/codex_nativepath.rs"],
    crate_name = "codex_nativepath_qualification_tests",
    crate_root = "qualification/codex_nativepath.rs",
    edition = crate_edition(),
    aliases = aliases(
        normal_dev = True,
        proc_macro_dev = True,
    ),
    deps = all_crate_deps(
        normal = True,
        normal_dev = True,
    ) + [
        ":lib",
    ],
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    tags = [
        "local",
        "manual",
        "qualification",
    ],
    visibility = ["//:__pkg__"],
)

ctx_rust_test(
    name = "unit_tests",
    srcs = RUST_SRCS,
    crate_name = "ctx_history_capture",
    crate_root = "src/lib.rs",
    compile_data = [
        "//:provider_support_matrix",
        "//:public_test_fixtures",
    ],
    edition = crate_edition(),
    aliases = aliases(
        normal_dev = True,
        proc_macro_dev = True,
    ),
    data = [
        "//:provider_support_matrix",
        "//:public_test_fixtures",
        ":provider_architecture_sources",
        "//crates/ctx-cli:provider_import_architecture_sources",
    ],
    deps = all_crate_deps(
        normal = True,
        normal_dev = True,
    ) + CTX_HISTORY_CAPTURE_DEPS,
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    rustc_env = COMMON_RUSTC_ENV,
)

ctx_rust_test(
    name = "complete_content_sqlite_tests",
    srcs = ["tests/complete_content_sqlite.rs"],
    crate_root = "tests/complete_content_sqlite.rs",
    edition = crate_edition(),
    aliases = aliases(
        normal_dev = True,
        proc_macro_dev = True,
    ),
    deps = all_crate_deps(
        normal = True,
        normal_dev = True,
    ) + [
        ":lib",
        "//crates/ctx-history-core:lib",
    ],
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    rustc_env = COMMON_RUSTC_ENV,
)

test_suite(
    name = "complete_content_tests",
    tests = [
        ":complete_content_sqlite_tests",
        ":unit_tests",
    ],
)
