load("@crates//:defs.bzl", "aliases", "all_crate_deps", "crate_deps", "crate_edition")
load("@rules_rust//rust:defs.bzl", "rust_library")
load("//:rust_sources.bzl", "RUST_PROD_SRC_EXCLUDES")
load("//tools/bazel:ctx_rust.bzl", "ctx_rust_test")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "cargo_package_data",
    srcs = glob(["**"], exclude = ["BUILD.bazel"]),
)

filegroup(
    name = "provider_architecture_sources",
    srcs = glob(
        [
            "src/provider/**/*.rs",
            "src/provider_sources.rs",
        ],
        exclude = RUST_PROD_SRC_EXCLUDES,
    ),
)

filegroup(
    name = "test_fixtures",
    srcs = glob([
        "tests/fixtures/**",
    ]),
)

COMMON_RUSTC_ENV = {
    "CARGO_MANIFEST_DIR": "crates/ctx-history-capture",
}

RUST_SRCS = glob(["src/**/*.rs"])

PROD_SRCS = glob(
    ["src/**/*.rs"],
    exclude = RUST_PROD_SRC_EXCLUDES,
)

CTX_HISTORY_CAPTURE_DEPS = [
    "//crates/ctx-history-capture-composition:lib",
    "//crates/ctx-history-capture-model:lib",
    "//crates/ctx-history-core:lib",
    "//crates/ctx-history-provider-runtime:lib",
    "//crates/ctx-history-provider-claude-cursor:lib",
    "//crates/ctx-history-source-discovery:lib",
    "//crates/ctx-history-source-io:lib",
]

rust_library(
    name = "lib",
    srcs = PROD_SRCS,
    crate_name = "ctx_history_capture",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    aliases = aliases(),
    deps = all_crate_deps(normal = True) + CTX_HISTORY_CAPTURE_DEPS,
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_env = COMMON_RUSTC_ENV,
)

rust_library(
    name = "qualification_lib",
    testonly = True,
    srcs = PROD_SRCS,
    crate_name = "ctx_history_capture",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    aliases = aliases(),
    deps = all_crate_deps(normal = True) + CTX_HISTORY_CAPTURE_DEPS,
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_env = COMMON_RUSTC_ENV,
    rustc_flags = [
        "--check-cfg=cfg(ctx_codex_causal_qualification)",
        "--check-cfg=cfg(test)",
        "--cfg=ctx_codex_causal_qualification",
    ],
)

ctx_rust_test(
    name = "unit_tests",
    srcs = RUST_SRCS,
    crate_name = "ctx_history_capture",
    crate_root = "src/lib.rs",
    compile_data = [
        "//:provider_import_policy",
        "//:provider_support_matrix",
        "//:public_test_fixtures",
        ":test_fixtures",
        "//crates/ctx-history-provider-codex:test_fixtures",
    ],
    edition = crate_edition(),
    aliases = aliases(
        normal_dev = True,
        proc_macro_dev = True,
    ),
    data = [
        "//:provider_support_matrix",
        "//:public_test_fixtures",
        ":provider_architecture_sources",
        "//crates/ctx-history-providers-sqlite-logical:provider_architecture_sources",
        "//crates/ctx-cli:provider_import_architecture_sources",
    ],
    deps = all_crate_deps(
        normal = True,
        normal_dev = True,
    ) + CTX_HISTORY_CAPTURE_DEPS,
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    rustc_env = COMMON_RUSTC_ENV,
)

ctx_rust_test(
    name = "self_contained_core_final_locator_removal_tests",
    srcs = [
        "tests/self_contained_core_final_locator_removal.rs",
    ] + PROD_SRCS,
    crate_name = "self_contained_core_final_locator_removal",
    crate_root = "tests/self_contained_core_final_locator_removal.rs",
    compile_data = [
        "//crates/ctx-history-core:src/lib.rs",
        "//crates/ctx-history-provider-claude-cursor:cargo_package_data",
        "//crates/ctx-history-source-sqlite:src/value.rs",
        "//crates/ctx-history-provider-docproj:src/providers/nanoclaw/native_path/source_backed.rs",
        "//crates/ctx-history-provider-docproj:src/providers/nanoclaw/position.rs",
        "//crates/ctx-history-provider-docproj:src/providers/nanoclaw/source.rs",
    ],
    edition = crate_edition(),
)

test_suite(
    name = "active_source_family_contract_tests",
    tests = [
        "//crates/ctx-history-capture-composition:unit_tests",
        "//crates/ctx-history-capture-runtime:unit_tests",
        "//crates/ctx-history-jsonl:unit_tests",
        "//crates/ctx-history-source-io:unit_tests",
        "//crates/ctx-history-source-sqlite:unit_tests",
    ],
)
