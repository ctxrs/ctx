load("@crates//:defs.bzl", "aliases", "all_crate_deps", "crate_edition")
load("@rules_python//python:defs.bzl", "py_binary", "py_test")
load("@rules_rust//rust:defs.bzl", "rust_library")
load("//:rust_sources.bzl", "RUST_PROD_SRC_EXCLUDES")
load("//tools/bazel:ctx_rust.bzl", "ctx_rust_test")
load("//tools/bazel:gates.bzl", "loc_check_inputs")
load(
    "//crates/ctx-history-capture:tests/mcp_attribution_suites.bzl",
    "mcp_attribution_suite_args",
    "mcp_attribution_suite_data",
)

package(default_visibility = ["//visibility:public"])

loc_check_inputs(name = "loc_check_inputs")

filegroup(
    name = "cargo_package_data",
    srcs = glob(["**"], exclude = ["BUILD.bazel"]),
)

filegroup(
    name = "provider_architecture_sources",
    srcs = glob(
        [
            "src/provider/**/*.rs",
            "src/provider_sources/**/*.rs",
        ],
        exclude = RUST_PROD_SRC_EXCLUDES,
    ),
)

filegroup(
    name = "test_fixtures",
    srcs = glob([
        "src/provider/**/tests/fixtures/**",
        "tests/fixtures/**",
    ]),
)

COMMON_RUSTC_ENV = {
    "CARGO_MANIFEST_DIR": "crates/ctx-history-capture",
}

RUST_SRCS = glob(["src/**/*.rs"])

MCP_ATTRIBUTION_ROUTE_CONTRACTS = glob([
    "tests/contracts/mcp-attribution/**/shape-contract.json",
])

MCP_ATTRIBUTION_TEST_CONTRACTS = glob([
    "tests/contracts/mcp-attribution-fixtures/**/shape-contract.json",
])

PROD_SRCS = glob(
    ["src/**/*.rs"],
    exclude = RUST_PROD_SRC_EXCLUDES,
)

CTX_HISTORY_CAPTURE_DEPS = [
    "//crates/ctx-history-core:lib",
    "//crates/ctx-history-index:lib",
    "//crates/ctx-pro-host-protocol:lib",
]

rust_library(
    name = "lib",
    srcs = PROD_SRCS,
    crate_name = "ctx_history_capture",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    aliases = aliases(),
    deps = all_crate_deps(normal = True) + CTX_HISTORY_CAPTURE_DEPS,
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_env = COMMON_RUSTC_ENV,
)

ctx_rust_test(
    name = "unit_tests",
    srcs = RUST_SRCS,
    crate_name = "ctx_history_capture",
    crate_root = "src/lib.rs",
    compile_data = [
        "//:provider_import_policy",
        "//:provider_support_matrix",
        "//:public_test_fixtures",
        ":test_fixtures",
    ],
    edition = crate_edition(),
    aliases = aliases(
        normal_dev = True,
        proc_macro_dev = True,
    ),
    data = [
        "//:provider_support_matrix",
        "//:public_test_fixtures",
        ":provider_architecture_sources",
        "//crates/ctx-cli:provider_import_architecture_sources",
    ],
    deps = all_crate_deps(
        normal = True,
        normal_dev = True,
    ) + CTX_HISTORY_CAPTURE_DEPS,
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    rustc_env = COMMON_RUSTC_ENV,
)

ctx_rust_test(
    name = "self_contained_core_final_locator_removal_tests",
    srcs = [
        "tests/self_contained_core_final_locator_removal.rs",
        "//crates/ctx-history-core:src/lib.rs",
    ] + PROD_SRCS,
    crate_name = "self_contained_core_final_locator_removal",
    crate_root = "tests/self_contained_core_final_locator_removal.rs",
    edition = crate_edition(),
)

ctx_rust_test(
    name = "codex_direct_result_tests",
    srcs = ["tests/codex_direct_result.rs"],
    crate_name = "codex_direct_result",
    crate_root = "tests/codex_direct_result.rs",
    compile_data = [":test_fixtures"],
    edition = crate_edition(),
    aliases = aliases(
        normal_dev = True,
        proc_macro_dev = True,
    ),
    deps = all_crate_deps(
        normal = True,
        normal_dev = True,
    ) + [":lib"] + CTX_HISTORY_CAPTURE_DEPS,
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    rustc_env = COMMON_RUSTC_ENV,
)

ctx_rust_test(
    name = "source_backed_route_contract_tests",
    srcs = ["tests/source_backed_route_contract.rs"],
    crate_name = "source_backed_route_contract",
    crate_root = "tests/source_backed_route_contract.rs",
    compile_data = [
        "//:provider_support_matrix",
        "tests/goldens/source-backed-route-registry-v1.json",
    ],
    edition = crate_edition(),
    aliases = aliases(normal = True),
    deps = all_crate_deps(normal = True) + [":lib"] + CTX_HISTORY_CAPTURE_DEPS,
    rustc_env = COMMON_RUSTC_ENV,
    tags = [
        "provider-conformance",
        "safe-presubmit",
        "source-backed",
    ],
)

py_test(
    name = "mcp_attribution_conformance_tests",
    srcs = [
        "tests/mcp_attribution_conformance.py",
        "tests/mcp_attribution_conformance_schema.py",
        "tests/mcp_attribution_contract_registry.py",
    ],
    imports = ["tests"],
    main = "tests/mcp_attribution_conformance.py",
    args = [
        "$(rootpath tests/mcp-attribution-conformance.manifest.json)",
        "$(rootpath //:provider_support_matrix)",
    ] + mcp_attribution_suite_args(),
    data = [
        "tests/mcp-attribution-conformance.manifest.json",
        "//:provider_support_matrix",
    ] + MCP_ATTRIBUTION_ROUTE_CONTRACTS + mcp_attribution_suite_data(),
    tags = [
        "privacy",
        "provider-conformance",
    ],
)

py_binary(
    name = "mcp_attribution_conformance_runner",
    srcs = [
        "tests/mcp_attribution_conformance.py",
        "tests/mcp_attribution_conformance_schema.py",
        "tests/mcp_attribution_contract_registry.py",
    ],
    imports = ["tests"],
    main = "tests/mcp_attribution_conformance.py",
)

py_test(
    name = "mcp_attribution_conformance_runner_tests",
    srcs = [
        "tests/mcp_attribution_conformance.py",
        "tests/mcp_attribution_conformance_schema.py",
        "tests/mcp_attribution_conformance_test.py",
        "tests/mcp_attribution_contract_registry.py",
    ],
    imports = ["tests"],
    main = "tests/mcp_attribution_conformance_test.py",
    data = MCP_ATTRIBUTION_ROUTE_CONTRACTS + MCP_ATTRIBUTION_TEST_CONTRACTS,
    tags = ["provider-conformance"],
)

ctx_rust_test(
    name = "repository_shell_outcomes_tests",
    srcs = [
        "tests/repository_shell_outcomes.rs",
        "src/repository_attribution/association.rs",
        "src/repository_attribution/outcome.rs",
        "src/repository_attribution/outcome/pull_request.rs",
        "src/repository_attribution/shell.rs",
        "src/repository_attribution/shell/outcome_tests.rs",
        "src/repository_attribution/shell/outcome_plan.rs",
        "src/repository_attribution/shell/pull_request.rs",
    ],
    crate_name = "repository_shell_outcomes",
    crate_root = "tests/repository_shell_outcomes.rs",
    edition = crate_edition(),
    aliases = aliases(
        normal_dev = True,
        proc_macro_dev = True,
    ),
    deps = all_crate_deps(
        normal = True,
        normal_dev = True,
    ) + [":lib"] + CTX_HISTORY_CAPTURE_DEPS,
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    rustc_env = COMMON_RUSTC_ENV,
)

sh_test(
    name = "active_source_family_contract_tests",
    srcs = ["tests/run-active-source-family-contracts.sh"],
    args = [
        "$(rootpath :unit_tests)",
        "$(rootpath tests/active-source-family-contract-tests.txt)",
    ],
    data = [
        ":unit_tests",
        "tests/active-source-family-contract-tests.txt",
    ],
    size = "small",
    tags = [
        "safe-presubmit",
        "source-backed",
        "source-family-contract",
    ],
)
