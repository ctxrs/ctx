load("@crates//:defs.bzl", "aliases", "all_crate_deps", "crate_edition")
load("@rules_rust//rust:defs.bzl", "rust_library")
load("//:rust_sources.bzl", "RUST_PROD_SRC_EXCLUDES")
load("//tools/bazel:ctx_rust.bzl", "ctx_rust_test")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "cargo_package_data",
    srcs = glob(["**"], exclude = ["BUILD.bazel"]),
)

filegroup(
    name = "canonical_discovery_environment_policy_source",
    testonly = True,
    srcs = ["src/provider_sources/context.rs"],
)

COMMON_RUSTC_ENV = {
    "CARGO_MANIFEST_DIR": "crates/ctx-history-source-discovery",
}

RUST_SRCS = glob(["src/**/*.rs"])

PROD_SRCS = glob(
    ["src/**/*.rs"],
    exclude = RUST_PROD_SRC_EXCLUDES,
)

CTX_HISTORY_SOURCE_DISCOVERY_DEPS = [
    "//crates/ctx-history-capture-model:lib",
    "//crates/ctx-history-core:lib",
    "//crates/ctx-history-openclaw-schema:lib",
    "//crates/ctx-history-platform:lib",
    "//crates/ctx-history-source-io:lib",
    "//crates/ctx-history-source-sqlite:lib",
]

rust_library(
    name = "lib",
    srcs = PROD_SRCS,
    crate_name = "ctx_history_source_discovery",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    aliases = aliases(),
    deps = all_crate_deps(normal = True) + CTX_HISTORY_SOURCE_DISCOVERY_DEPS,
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_env = COMMON_RUSTC_ENV,
)

ctx_rust_test(
    name = "unit_tests",
    srcs = RUST_SRCS,
    crate_name = "ctx_history_source_discovery",
    crate_root = "src/lib.rs",
    compile_data = [
        "//:provider_support_matrix",
        "//:public_test_fixtures",
    ],
    edition = crate_edition(),
    aliases = aliases(normal = True, normal_dev = True, proc_macro_dev = True),
    deps = all_crate_deps(normal = True, normal_dev = True) + [
        "//crates/ctx-history-capture-model:lib",
        "//crates/ctx-history-core:lib",
        "//crates/ctx-history-openclaw-schema:test_support_lib",
        "//crates/ctx-history-platform:lib",
        "//crates/ctx-history-source-io:test_support_lib",
        "//crates/ctx-history-source-sqlite:test_support_lib",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True, proc_macro_dev = True),
    rustc_env = COMMON_RUSTC_ENV,
)

test_suite(
    name = "qualification_tests",
    tests = ["//crates/ctx-history-source-discovery-qualification:unit_tests"],
)
