load("@crates//:defs.bzl", "aliases", "all_crate_deps", "crate_edition")
load("@rules_rust//rust:defs.bzl", "rust_library")
load("//:rust_sources.bzl", "RUST_PROD_SRC_EXCLUDES")
load("//tools/bazel:ctx_rust.bzl", "ctx_rust_test")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "cargo_package_data",
    srcs = glob(["**"], exclude = ["BUILD.bazel"]),
)

COMMON_RUSTC_ENV = {"CARGO_MANIFEST_DIR": "crates/ctx-history-provider-native-jsonl"}
RUST_SRCS = glob(["src/**/*.rs"])
PROD_SRCS = glob(["src/**/*.rs"], exclude = RUST_PROD_SRC_EXCLUDES)

NATIVE_JSONL_DEPS = [
    "//crates/ctx-history-capture-model:lib",
    "//crates/ctx-history-capture-runtime:lib",
    "//crates/ctx-history-core:lib",
    "//crates/ctx-history-jsonl:lib",
    "//crates/ctx-history-native-jsonl-parsers:lib",
    "//crates/ctx-history-source-io:lib",
]

NATIVE_JSONL_TEST_DEPS = [
    "//crates/ctx-history-capture-model:lib",
    "//crates/ctx-history-capture-runtime:lib",
    "//crates/ctx-history-core:lib",
    "//crates/ctx-history-jsonl:test_support_lib",
    "//crates/ctx-history-native-jsonl-parsers:lib",
    "//crates/ctx-history-source-io:test_support_lib",
]

rust_library(
    name = "lib",
    srcs = PROD_SRCS,
    crate_name = "ctx_history_provider_native_jsonl",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    aliases = aliases(),
    deps = all_crate_deps(normal = True) + NATIVE_JSONL_DEPS,
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_env = COMMON_RUSTC_ENV,
    visibility = ["//crates/ctx-history-capture-composition:__pkg__"],
)

# Test feature access remains outside the production graph by construction.
rust_library(
    name = "test_support_lib",
    testonly = True,
    srcs = PROD_SRCS,
    crate_name = "ctx_history_provider_native_jsonl",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    aliases = aliases(normal = True, normal_dev = True, proc_macro_dev = True),
    deps = all_crate_deps(normal = True, normal_dev = True) + NATIVE_JSONL_TEST_DEPS,
    proc_macro_deps = all_crate_deps(proc_macro = True, proc_macro_dev = True),
    rustc_env = COMMON_RUSTC_ENV,
    visibility = [
        "//crates/ctx-history-capture-composition:__pkg__",
        "//crates/ctx-history-capture-composition-qualification:__pkg__",
    ],
)

ctx_rust_test(
    name = "unit_tests",
    srcs = RUST_SRCS,
    crate_name = "ctx_history_provider_native_jsonl",
    crate_root = "src/lib.rs",
    compile_data = ["//:public_test_fixtures"],
    edition = crate_edition(),
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = all_crate_deps(normal = True, normal_dev = True) + NATIVE_JSONL_TEST_DEPS,
    proc_macro_deps = all_crate_deps(proc_macro = True, proc_macro_dev = True),
    data = ["//:public_test_fixtures"],
    rustc_env = COMMON_RUSTC_ENV,
)
