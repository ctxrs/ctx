load("@crates//:defs.bzl", "aliases", "all_crate_deps", "crate_deps", "crate_edition")
load("@rules_rust//rust:defs.bzl", "rust_library")
load("//:rust_sources.bzl", "RUST_PROD_SRC_EXCLUDES")
load("//tools/bazel:binary_contracts.bzl", "ctx_binary_contract_test")
load("//tools/bazel:ctx_rust.bzl", "ctx_rust_binary", "ctx_rust_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "BUILD.bazel",
    "Cargo.toml",
    "build.rs",
    "test-harness.env",
])

filegroup(
    name = "cargo_package_data",
    srcs = glob(["**"], exclude = ["BUILD.bazel"]),
)

COMMON_RUSTC_ENV = {
    "CARGO_MANIFEST_DIR": "crates/ctx-upgrade-engine",
}

RUST_SRCS = glob(["src/**/*.rs"])

PROD_SRCS = glob(
    ["src/**/*.rs"],
    exclude = RUST_PROD_SRC_EXCLUDES,
)

CTX_UPGRADE_ENGINE_DEPS = [
    "//crates/ctx-history-core:lib",
    "//crates/ctx-history-platform:lib",
    "//crates/ctx-managed-pair-engine:lib",
]

CTX_UPGRADE_ENGINE_RUSTC_FLAGS = [
    "--check-cfg=cfg(ctx_release_qualification)",
    "--check-cfg=cfg(ctx_upgrade_engine_test_support)",
    "--check-cfg=cfg(ctx_cli_bazel_test)",
    "--check-cfg=cfg(test)",
    '--check-cfg=cfg(feature, values("test-support"))',
]

rust_library(
    name = "lib",
    srcs = PROD_SRCS,
    crate_name = "ctx_upgrade_engine",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    aliases = aliases(),
    deps = all_crate_deps(normal = True) + CTX_UPGRADE_ENGINE_DEPS,
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_env = COMMON_RUSTC_ENV,
    rustc_flags = CTX_UPGRADE_ENGINE_RUSTC_FLAGS,
)

rust_library(
    name = "test_support_lib",
    testonly = True,
    srcs = PROD_SRCS,
    crate_name = "ctx_upgrade_engine",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    aliases = aliases(),
    deps = all_crate_deps(normal = True) + CTX_UPGRADE_ENGINE_DEPS,
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_env = COMMON_RUSTC_ENV,
    rustc_flags = CTX_UPGRADE_ENGINE_RUSTC_FLAGS + ['--cfg=feature="test-support"'],
)

rust_library(
    name = "qualification_lib",
    testonly = True,
    srcs = PROD_SRCS,
    crate_name = "ctx_upgrade_engine",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    aliases = aliases(),
    deps = all_crate_deps(normal = True) + CTX_UPGRADE_ENGINE_DEPS,
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_env = COMMON_RUSTC_ENV,
    rustc_env_files = ["test-harness.env"],
    rustc_flags = CTX_UPGRADE_ENGINE_RUSTC_FLAGS + [
        "--cfg=ctx_release_qualification",
        "--cfg=ctx_upgrade_engine_test_support",
    ],
)

ctx_rust_test(
    name = "unit_tests",
    srcs = RUST_SRCS,
    crate_name = "ctx_upgrade_engine",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = all_crate_deps(normal = True, normal_dev = True) + CTX_UPGRADE_ENGINE_DEPS,
    proc_macro_deps = all_crate_deps(proc_macro = True, proc_macro_dev = True),
    rustc_env = COMMON_RUSTC_ENV,
    rustc_env_files = ["test-harness.env"],
    rustc_flags = CTX_UPGRADE_ENGINE_RUSTC_FLAGS,
    tags = ["exclusive"],
)

ctx_rust_binary(
    name = "ctx_v025_upgrade_fixture",
    testonly = True,
    srcs = ["tests/fixtures/v025_upgrade_fixture.rs"],
    crate_name = "ctx_v025_upgrade_fixture",
    crate_root = "tests/fixtures/v025_upgrade_fixture.rs",
    edition = crate_edition(),
    aliases = aliases(),
    deps = all_crate_deps(normal = True),
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_env_files = ["//crates/ctx-cli:cargo_toml_env_vars"],
)

ctx_binary_contract_test(
    name = "upgrade_tests",
    src = "tests/contracts/upgrade.rs",
    binary = "//crates/ctx-cli:ctx_upgrade_test_harness",
    cargo_manifest_dir = "crates/ctx-upgrade-engine",
    support_deps = crate_deps([
        "base64",
        "chrono",
        "flate2",
        "ring",
        "serde_json",
        "sha2",
        "tar",
        "tempfile",
        "uuid",
    ]) + [
        "@crates//assert_cmd-2.2.2:assert_cmd-2.2.2",
        "@crates//predicates-3.1.4:predicates-3.1.4",
        "//crates/ctx-history-core:lib",
        "//crates/ctx-history-platform:lib",
    ],
    support_srcs = [
        "tests/contracts/support.rs",
        "//crates/ctx-cli-contract-tests:contract_support_base",
        "//crates/ctx-cli-contract-tests:contract_support_upgrade",
    ],
    support_rustc_flags = ["--cfg=ctx_cli_test_support_upgrade"],
    extra_crates = ["libc"],
    extra_env = {
        "CTX_ORDINARY_RELEASE_BINARY": "$(rootpath //crates/ctx-cli:ctx)",
    },
    extra_compile_data = [
        "src/upgrade/install/archive.rs",
        "src/upgrade/install.rs",
        "//:upgrade_extractor_contract",
    ],
    extra_data = ["//crates/ctx-cli:ctx"],
    extra_srcs = [
        "//crates/ctx-cli-contract-tests:upgrade_runtime_support_srcs",
        "tests/contracts/upgrade/release_validation.rs",
        "tests/contracts/upgrade/unmanaged.rs",
    ],
    rustc_env_files = ["//crates/ctx-cli:cargo_toml_env_vars"],
)
