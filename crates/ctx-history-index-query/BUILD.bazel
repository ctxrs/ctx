load("@crates//:defs.bzl", "aliases", "all_crate_deps", "crate_edition")
load("@rules_rust//rust:defs.bzl", "rust_doc_test", "rust_library")
load("//:rust_sources.bzl", "RUST_PROD_SRC_EXCLUDES")
load("//tools/bazel:ctx_rust.bzl", "ctx_rust_test")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "cargo_package_data",
    srcs = glob(["**"], exclude = ["BUILD.bazel"]),
)

COMMON_RUSTC_ENV = {
    "CARGO_MANIFEST_DIR": "crates/ctx-history-index-query",
}

RUST_SRCS = glob(["src/**/*.rs"])
PROD_SRCS = glob(["src/**/*.rs"], exclude = RUST_PROD_SRC_EXCLUDES)

QUERY_DEPS = [
    "//crates/ctx-history-core:lib",
    "//crates/ctx-history-index-format:lib",
    "//crates/ctx-history-index-generation:lib",
]

QUERY_TEST_SUPPORT_DEPS = [
    "//crates/ctx-history-core:lib",
    "//crates/ctx-history-index-format:test_support_lib",
    "//crates/ctx-history-index-generation:test_support_lib",
]

rust_library(
    name = "lib",
    srcs = PROD_SRCS,
    crate_name = "ctx_history_index_query",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    aliases = aliases(),
    deps = all_crate_deps(normal = True) + QUERY_DEPS,
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_env = COMMON_RUSTC_ENV,
)

rust_library(
    name = "test_support_lib",
    testonly = True,
    srcs = PROD_SRCS,
    crate_name = "ctx_history_index_query",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    aliases = aliases(),
    deps = all_crate_deps(normal = True) + QUERY_TEST_SUPPORT_DEPS,
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_env = COMMON_RUSTC_ENV,
    rustc_flags = ['--cfg=feature="test-support"'],
)

# The feature-enabled library is intentional: this compile-fail contract
# exercises the maximal shippable Cargo feature surface.
rust_doc_test(
    name = "publication_seal_doc_tests",
    crate = ":test_support_lib",
)

ctx_rust_test(
    name = "unit_tests",
    srcs = RUST_SRCS,
    crate_name = "ctx_history_index_query",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = all_crate_deps(normal = True, normal_dev = True) + QUERY_TEST_SUPPORT_DEPS,
    proc_macro_deps = all_crate_deps(proc_macro = True, proc_macro_dev = True),
    rustc_env = COMMON_RUSTC_ENV,
)

ctx_rust_test(
    name = "writer_integration_tests",
    srcs = ["tests/writer_integration.rs"] + glob(["tests/writer_integration/**/*.rs"]),
    crate_name = "ctx_history_index_query_writer_integration",
    crate_root = "tests/writer_integration.rs",
    edition = crate_edition(),
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = all_crate_deps(normal = True, normal_dev = True) + [
        "//crates/ctx-history-core:lib",
        "//crates/ctx-history-index-format:test_support_lib",
        "//crates/ctx-history-index-generation:test_support_lib",
        "//crates/ctx-history-index-query:test_support_lib",
        "//crates/ctx-history-index:test_support_lib",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True, proc_macro_dev = True),
    rustc_env = COMMON_RUSTC_ENV,
)
