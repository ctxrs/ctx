load("@crates//:defs.bzl", "crate_deps", "crate_edition")
load("//crates/ctx-cli-contract-tests:test_targets.bzl", "ctx_cli_contract_test")
load("//tools/bazel:ctx_rust.bzl", "ctx_rust_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "BUILD.bazel",
    "Cargo.toml",
])

filegroup(
    name = "cargo_package_data",
    srcs = glob(["**"], exclude = ["BUILD.bazel"]),
)

ctx_cli_contract_test(
    name = "index_tests",
    src = "tests/index.rs",
    extra_crates = ["anstream"],
    test_support = [
        "base",
        "fixtures",
    ],
)

ctx_cli_contract_test(
    name = "stats_tests",
    src = "tests/stats.rs",
    deps = [
        "//crates/ctx-history-core:lib",
        "//crates/ctx-history-index:lib",
    ],
    extra_crates = ["rusqlite"],
    tags = ["cli-contract", "privacy"],
)

ctx_rust_test(
    name = "grok_build_tests",
    testonly = True,
    srcs = ["tests/grok_build.rs"],
    crate_name = "ctx_grok_build_qualification",
    crate_root = "tests/grok_build.rs",
    edition = crate_edition(),
    compile_data = ["//:public_test_fixtures"],
    data = [
        "//:public_test_fixtures",
        "//crates/ctx-cli:ctx",
    ],
    deps = crate_deps([
        "assert_cmd",
        "serde_json",
        "tempfile",
    ]),
    rustc_env = {
        "CARGO_MANIFEST_DIR": "crates/ctx-cli-qualification",
    },
    env = {
        "CARGO_BIN_EXE_ctx": "$(rootpath //crates/ctx-cli:ctx)",
    },
)
