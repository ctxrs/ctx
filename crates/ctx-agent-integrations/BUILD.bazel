load("@crates//:defs.bzl", "aliases", "all_crate_deps", "crate_edition")
load("@rules_rust//rust:defs.bzl", "rust_library")
load("//:rust_sources.bzl", "RUST_PROD_SRC_EXCLUDES")
load("//tools/bazel:ctx_rust.bzl", "ctx_rust_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "BUILD.bazel",
    "Cargo.toml",
])

filegroup(
    name = "cargo_package_data",
    srcs = glob(["**"], exclude = ["BUILD.bazel"]),
)

COMMON_RUSTC_ENV = {
    "CARGO_MANIFEST_DIR": "crates/ctx-agent-integrations",
}

RUST_SRCS = glob(["src/**/*.rs"])

PROD_SRCS = glob(
    ["src/**/*.rs"],
    exclude = RUST_PROD_SRC_EXCLUDES,
)

CTX_AGENT_INTEGRATIONS_DEPS = [
    "//crates/ctx-attribution-model:lib",
    "//crates/ctx-client-observability:lib",
    "//crates/ctx-history-core:lib",
]

rust_library(
    name = "lib",
    srcs = PROD_SRCS,
    crate_name = "ctx_agent_integrations",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    aliases = aliases(),
    compile_data = ["//:ctx_bundled_skills"],
    deps = all_crate_deps(normal = True) + CTX_AGENT_INTEGRATIONS_DEPS,
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_env = COMMON_RUSTC_ENV,
)

rust_library(
    name = "test_support_lib",
    testonly = True,
    srcs = PROD_SRCS,
    crate_name = "ctx_agent_integrations",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    aliases = aliases(),
    compile_data = ["//:ctx_bundled_skills"],
    deps = all_crate_deps(normal = True) + [
        "//crates/ctx-attribution-model:lib",
        "//crates/ctx-client-observability:test_support_lib",
        "//crates/ctx-history-core:lib",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_env = COMMON_RUSTC_ENV,
)

ctx_rust_test(
    name = "unit_tests",
    srcs = RUST_SRCS,
    crate_name = "ctx_agent_integrations",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    compile_data = [
        "//:ctx_bundled_skills",
        "src/skill/testdata/legacy_skill_v0_17_0.md",
    ],
    deps = all_crate_deps(normal = True, normal_dev = True) + CTX_AGENT_INTEGRATIONS_DEPS,
    proc_macro_deps = all_crate_deps(proc_macro = True, proc_macro_dev = True),
    rustc_env = COMMON_RUSTC_ENV,
)
