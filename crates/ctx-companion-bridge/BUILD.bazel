load("@crates//:defs.bzl", "aliases", "all_crate_deps", "crate_edition")
load("@rules_rust//rust:defs.bzl", "rust_library")
load("//:rust_sources.bzl", "RUST_PROD_SRC_EXCLUDES")
load("//tools/bazel:ctx_rust.bzl", "ctx_rust_test")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "cargo_package_data",
    srcs = glob(["**"], exclude = ["BUILD.bazel"]),
)

COMMON_RUSTC_ENV = {
    "CARGO_MANIFEST_DIR": "crates/ctx-companion-bridge",
}

RUST_SRCS = glob(["src/**/*.rs"])
PROD_SRCS = glob(["src/**/*.rs"], exclude = RUST_PROD_SRC_EXCLUDES)
COMPILE_DATA = [
    "//:contracts/ctx-managed-pair-release-authority-v1.json",
    "//:contracts/ctx-managed-pair-state-v1.schema.json",
    "//:release_target_matrix",
]

rust_library(
    name = "lib",
    srcs = PROD_SRCS,
    crate_name = "ctx_companion_bridge",
    crate_root = "src/lib.rs",
    compile_data = COMPILE_DATA,
    edition = crate_edition(),
    aliases = aliases(),
    deps = all_crate_deps(normal = True),
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_env = COMMON_RUSTC_ENV,
    rustc_flags = ["--check-cfg=cfg(test)", "--check-cfg=cfg(ctx_release_qualification)"],
)

rust_library(
    name = "qualification_lib",
    testonly = True,
    srcs = PROD_SRCS,
    crate_name = "ctx_companion_bridge",
    crate_root = "src/lib.rs",
    compile_data = COMPILE_DATA,
    edition = crate_edition(),
    aliases = aliases(),
    deps = all_crate_deps(normal = True),
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_env = COMMON_RUSTC_ENV,
    rustc_flags = ["--check-cfg=cfg(test)", "--check-cfg=cfg(ctx_release_qualification)", "--cfg=ctx_release_qualification"],
)

ctx_rust_test(
    name = "unit_tests",
    srcs = RUST_SRCS,
    crate_name = "ctx_companion_bridge",
    crate_root = "src/lib.rs",
    compile_data = COMPILE_DATA + ["//:legacy_unified_envelope_fixtures"],
    edition = crate_edition(),
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = all_crate_deps(normal = True, normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro = True, proc_macro_dev = True),
    rustc_env = COMMON_RUSTC_ENV,
    rustc_flags = ["--check-cfg=cfg(test)", "--check-cfg=cfg(ctx_release_qualification)"],
    tags = ["exclusive", "security"],
)

ctx_rust_test(
    name = "qualification_tests",
    srcs = RUST_SRCS,
    crate_name = "ctx_companion_bridge",
    crate_root = "src/lib.rs",
    compile_data = COMPILE_DATA + ["//:legacy_unified_envelope_fixtures"],
    edition = crate_edition(),
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = all_crate_deps(normal = True, normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro = True, proc_macro_dev = True),
    rustc_env = COMMON_RUSTC_ENV,
    rustc_flags = ["--check-cfg=cfg(test)", "--check-cfg=cfg(ctx_release_qualification)", "--cfg=ctx_release_qualification"],
    tags = ["exclusive", "security"],
)
