load("@crates//:defs.bzl", "aliases", "all_crate_deps", "crate_edition")
load("@rules_rust//rust:defs.bzl", "rust_library")
load("//:rust_sources.bzl", "RUST_PROD_SRC_EXCLUDES")
load("//tools/bazel:ctx_rust.bzl", "ctx_rust_test")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

filegroup(
    name = "cargo_package_data",
    srcs = glob(["**"], exclude = ["BUILD.bazel"]),
)

filegroup(
    name = "boundary_sources",
    srcs = glob(["src/**/*.rs"]),
)

COMMON_RUSTC_ENV = {"CARGO_MANIFEST_DIR": "crates/ctx-attribution"}

RUST_SRCS = glob(["src/**/*.rs"])
PROD_SRCS = glob(["src/**/*.rs"], exclude = RUST_PROD_SRC_EXCLUDES)

rust_library(
    name = "lib",
    srcs = PROD_SRCS,
    crate_name = "ctx_attribution",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    aliases = aliases(),
    deps = all_crate_deps(normal = True) + [
        "//crates/ctx-attribution-derivation:lib",
        "//crates/ctx-attribution-model:lib",
        "//crates/ctx-attribution-index:lib",
        "//crates/ctx-repository-evidence:lib",
        "//crates/ctx-history-core:lib",
        "//crates/ctx-history-platform:lib",
        "//crates/ctx-history-snapshot-reader:lib",
        "//crates/ctx-terminal:lib",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_env = COMMON_RUSTC_ENV,
)

rust_library(
    name = "test_support_lib",
    testonly = True,
    rustc_flags = ['--cfg=feature="test-support"'],
    srcs = PROD_SRCS,
    crate_name = "ctx_attribution",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    aliases = aliases(),
    deps = all_crate_deps(normal = True) + [
        "//crates/ctx-attribution-derivation:test_support_lib",
        "//crates/ctx-attribution-model:lib",
        "//crates/ctx-attribution-index:test_support_lib",
        "//crates/ctx-repository-evidence:lib",
        "//crates/ctx-history-core:lib",
        "//crates/ctx-history-platform:lib",
        "//crates/ctx-history-snapshot-reader:lib",
        "//crates/ctx-terminal:lib",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_env = COMMON_RUSTC_ENV,
)

ctx_rust_test(
    name = "unit_tests",
    srcs = RUST_SRCS,
    crate_name = "ctx_attribution",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = all_crate_deps(normal = True, normal_dev = True) + [
        "//crates/ctx-attribution-derivation:test_support_lib",
        "//crates/ctx-attribution-model:lib",
        "//crates/ctx-attribution-index:test_support_lib",
        "//crates/ctx-repository-evidence:lib",
        "//crates/ctx-history-core:lib",
        "//crates/ctx-history-platform:lib",
        "//crates/ctx-history-snapshot-reader:lib",
        "//crates/ctx-terminal:lib",
        "//crates/ctx-history-index:lib",
        "//crates/ctx-history-index-format:lib",
        "//crates/ctx-history-index-query:lib",
    ],
    compile_data = glob(["testdata/**/*.txt"]),
    proc_macro_deps = all_crate_deps(proc_macro = True, proc_macro_dev = True),
    rustc_env = COMMON_RUSTC_ENV,
)
