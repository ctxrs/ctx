load("@crates//:defs.bzl", "aliases", "all_crate_deps", "crate_edition")
load("@rules_rust//rust:defs.bzl", "rust_library")
load("//:rust_sources.bzl", "RUST_PROD_SRC_EXCLUDES")
load("//tools/bazel:ctx_rust.bzl", "ctx_rust_test")
load(":test_targets.bzl", "observability_binary_contract")

package(default_visibility = ["//visibility:public"])

exports_files([
    "BUILD.bazel",
    "Cargo.toml",
    "test_targets.bzl",
])

filegroup(
    name = "cargo_package_data",
    srcs = glob(["**"], exclude = ["BUILD.bazel"]),
)

COMMON_RUSTC_ENV = {"CARGO_MANIFEST_DIR": "crates/ctx-client-observability"}
RUST_SRCS = glob(["src/**/*.rs"])
PROD_SRCS = glob(["src/**/*.rs"], exclude = RUST_PROD_SRC_EXCLUDES)
SCHEMA_SRCS = glob(["src/**/*.sql"])
CTX_CLIENT_OBSERVABILITY_DEPS = [
    "//crates/ctx-history-core:lib",
    "//crates/ctx-history-platform:lib",
]
CTX_CLIENT_OBSERVABILITY_RUSTC_FLAGS = [
    "--check-cfg=cfg(test)",
    '--check-cfg=cfg(feature, values("local-usage", "test-support"))',
    '--cfg=feature="local-usage"',
]

rust_library(
    name = "lib",
    srcs = PROD_SRCS,
    compile_data = SCHEMA_SRCS,
    crate_name = "ctx_client_observability",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    aliases = aliases(),
    deps = all_crate_deps(normal = True) + CTX_CLIENT_OBSERVABILITY_DEPS,
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_env = COMMON_RUSTC_ENV,
    rustc_flags = CTX_CLIENT_OBSERVABILITY_RUSTC_FLAGS,
)

rust_library(
    name = "test_support_lib",
    testonly = True,
    srcs = PROD_SRCS,
    compile_data = SCHEMA_SRCS,
    crate_name = "ctx_client_observability",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    aliases = aliases(),
    deps = all_crate_deps(normal = True) + CTX_CLIENT_OBSERVABILITY_DEPS,
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_env = COMMON_RUSTC_ENV,
    rustc_flags = CTX_CLIENT_OBSERVABILITY_RUSTC_FLAGS + ['--cfg=feature="test-support"'],
)

ctx_rust_test(
    name = "unit_tests",
    srcs = RUST_SRCS,
    crate_name = "ctx_client_observability",
    crate_root = "src/lib.rs",
    compile_data = SCHEMA_SRCS + ["//:telemetry_contract_fixtures"],
    edition = crate_edition(),
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = all_crate_deps(normal = True, normal_dev = True) + CTX_CLIENT_OBSERVABILITY_DEPS,
    proc_macro_deps = all_crate_deps(proc_macro = True, proc_macro_dev = True),
    rustc_env = COMMON_RUSTC_ENV,
    rustc_flags = CTX_CLIENT_OBSERVABILITY_RUSTC_FLAGS,
)

observability_binary_contract(
    name = "analytics_tests",
    binary = "//crates/ctx-cli:ctx_upgrade_test_harness",
    fixtures = True,
    src = "tests/contracts/analytics.rs",
    upgrade = True,
)

observability_binary_contract(
    name = "analytics_identity_tests",
    src = "tests/contracts/analytics_identity.rs",
)

observability_binary_contract(
    name = "analytics_policy_tests",
    src = "tests/contracts/analytics_policy.rs",
)

observability_binary_contract(
    name = "local_usage_tests",
    extra_deps = ["@crates//:rusqlite-0.32.1"],
    src = "tests/contracts/local_usage.rs",
    tags = ["privacy"],
)

observability_binary_contract(
    name = "upgrade_analytics_tests",
    binary = "//crates/ctx-cli:ctx_upgrade_test_harness",
    src = "tests/contracts/upgrade_analytics.rs",
    upgrade = True,
)
