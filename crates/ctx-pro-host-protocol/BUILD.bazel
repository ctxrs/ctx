load("@crates//:defs.bzl", "aliases", "all_crate_deps", "crate_edition")
load("@rules_rust//rust:defs.bzl", "rust_library")
load("//:rust_sources.bzl", "RUST_PROD_SRC_EXCLUDES")
load("//tools/bazel:ctx_rust.bzl", "ctx_rust_binary", "ctx_rust_test")
load("//tools/bazel:gates.bzl", "loc_check_inputs")

package(default_visibility = ["//visibility:public"])

loc_check_inputs(name = "loc_check_inputs")

filegroup(
    name = "cargo_package_data",
    srcs = glob(["**"], exclude = ["BUILD.bazel"]),
)

COMMON_RUSTC_ENV = {
    "CARGO_MANIFEST_DIR": "crates/ctx-pro-host-protocol",
}

RUST_SRCS = glob(["src/**/*.rs"])

CONFORMANCE_DATA = glob(["testdata/**/*.json"])

filegroup(
    name = "entitlement_golden_vectors",
    srcs = glob(["testdata/entitlement/**/*.json"]),
)

PROD_SRCS = glob(
    ["src/**/*.rs"],
    exclude = RUST_PROD_SRC_EXCLUDES,
)

CTX_PRO_HOST_PROTOCOL_DEPS = [
    "//crates/ctx-history-core:lib",
]

rust_library(
    name = "lib",
    srcs = PROD_SRCS,
    crate_name = "ctx_pro_host_protocol",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    aliases = aliases(),
    deps = all_crate_deps(normal = True) + CTX_PRO_HOST_PROTOCOL_DEPS,
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_env = COMMON_RUSTC_ENV,
)

ctx_rust_binary(
    name = "generate_protocol_inventory",
    srcs = ["examples/generate_protocol_inventory.rs"],
    crate_name = "generate_protocol_inventory",
    crate_root = "examples/generate_protocol_inventory.rs",
    edition = crate_edition(),
    aliases = aliases(),
    deps = all_crate_deps(normal = True) + [":lib"],
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_env = COMMON_RUSTC_ENV,
)

sh_test(
    name = "protocol_inventory_regeneration_test",
    srcs = ["check_inventory.sh"],
    args = [
        "$(rootpath :generate_protocol_inventory)",
        "$(rootpath testdata/v1/inventory.json)",
        "$(rootpath src/protocol_fingerprint.rs)",
    ],
    data = [
        ":generate_protocol_inventory",
        "src/protocol_fingerprint.rs",
        "testdata/v1/inventory.json",
    ],
)

ctx_rust_test(
    name = "unit_tests",
    srcs = RUST_SRCS,
    crate_name = "ctx_pro_host_protocol",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    aliases = aliases(
        normal_dev = True,
        proc_macro_dev = True,
    ),
    compile_data = CONFORMANCE_DATA,
    deps = all_crate_deps(
        normal = True,
        normal_dev = True,
    ) + CTX_PRO_HOST_PROTOCOL_DEPS,
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    rustc_env = COMMON_RUSTC_ENV,
)

ctx_rust_test(
    name = "conformance_tests",
    srcs = RUST_SRCS,
    crate_name = "ctx_pro_host_protocol_conformance",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    aliases = aliases(
        normal_dev = True,
        proc_macro_dev = True,
    ),
    compile_data = CONFORMANCE_DATA,
    args = ["conformance"],
    deps = all_crate_deps(
        normal = True,
        normal_dev = True,
    ) + CTX_PRO_HOST_PROTOCOL_DEPS,
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    rustc_env = COMMON_RUSTC_ENV,
    tags = ["protocol"],
)
