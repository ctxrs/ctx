    "//:ctx_bundled_skills",
    "//:ctx_embedded_docs",
]

CTX_CLI_TEST_COMPILE_DATA = CTX_CLI_COMPILE_DATA + [
    "//:release_contracts",
    "//:telemetry_contract_fixtures",
    "//crates/ctx-client-observability:cargo_package_data",
    "//crates/ctx-daemon-runtime:cargo_package_data",
]

RUST_SRCS = glob(["src/**/*.rs"])

PROD_SRCS = glob(
    ["src/**/*.rs"],
    exclude = RUST_PROD_SRC_EXCLUDES,
)

ctx_rust_binary(
    name = "ctx",
    srcs = PROD_SRCS,
    crate_name = "ctx",
    crate_root = "src/main.rs",
    edition = crate_edition(),
    aliases = aliases(),
    compile_data = CTX_CLI_COMPILE_DATA,
    deps = all_crate_deps(normal = True) + CTX_CLI_DEPS,
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_env = RELEASE_BUILD_RUSTC_ENV,
    rustc_env_files = [
        ":cargo_toml_env_vars",
        "release-stamp.env",
    ],
    rustc_flags = CTX_CLI_RUSTC_FLAGS,
    stamp = -1,
)

# The auto-upgrade acceptance harness needs its deterministic crash and pause
# seams even when the surrounding release gate uses optimized compilation.
# Keep that authority in a test-only executable rather than enabling test hooks
# in the published release binary.
ctx_rust_binary(
    name = "ctx_auto_upgrade_acceptance_fixture",
    testonly = True,
    srcs = PROD_SRCS,
    crate_name = "ctx_auto_upgrade_acceptance_fixture",
    crate_root = "src/main.rs",
    edition = crate_edition(),
    aliases = aliases(),
    compile_data = CTX_CLI_COMPILE_DATA,
    deps = all_crate_deps(normal = True) + CTX_CLI_QUALIFICATION_DEPS,
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_env = RELEASE_BUILD_RUSTC_ENV,
    rustc_env_files = [
        ":cargo_toml_env_vars",
        "release-stamp.env",
    ],
    rustc_flags = CTX_CLI_RUSTC_FLAGS + [
        "--cfg=ctx_release_qualification",
        "-Cdebug-assertions=yes",
    ],
    stamp = -1,
)

# Hosted-uninstall release tests need a synchronization marker that remains
# absent from the published binary. Compile that authority into this optimized
# test-only host instead of depending on debug assertions.
ctx_rust_binary(
    name = "ctx_hosted_uninstall_test_host",
    testonly = True,
    srcs = PROD_SRCS,
    crate_name = "ctx_hosted_uninstall_test_host",
    crate_root = "src/main.rs",
    edition = crate_edition(),
    aliases = aliases(),
    compile_data = CTX_CLI_COMPILE_DATA,
    deps = all_crate_deps(normal = True) + CTX_CLI_QUALIFICATION_DEPS,
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_env = RELEASE_BUILD_RUSTC_ENV,
    rustc_env_files = [
        ":cargo_toml_env_vars",
        "release-stamp.env",
    ],
    rustc_flags = CTX_CLI_RUSTC_FLAGS + ["--cfg=ctx_release_qualification"],
    stamp = -1,
)

ctx_rust_binary(
    name = "ctx_upgrade_test_harness",
    testonly = True,
    srcs = PROD_SRCS,
    crate_name = "ctx",
    crate_root = "src/main.rs",
    edition = crate_edition(),
    aliases = aliases(),
    compile_data = CTX_CLI_COMPILE_DATA,
    deps = all_crate_deps(normal = True) + CTX_CLI_QUALIFICATION_DEPS,
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_env = RELEASE_BUILD_RUSTC_ENV,
    rustc_env_files = [
        ":cargo_toml_env_vars",
        "release-stamp.env",
    ],
    # Local metadata/signature/key injection exists only in this test-only
    # build capability. The published :ctx target cannot select it.
    rustc_flags = CTX_CLI_RUSTC_FLAGS + ["--cfg=ctx_release_qualification"],
    stamp = -1,
)

ctx_rust_test(
    name = "unit_tests",
    srcs = RUST_SRCS,
    crate_name = "ctx",
    crate_root = "src/main.rs",
    edition = crate_edition(),
    aliases = aliases(
        normal_dev = True,
        proc_macro_dev = True,
    ),
    compile_data = CTX_CLI_TEST_COMPILE_DATA + [
        "//crates/ctx-upgrade-engine:cargo_package_data",
    ],
    data = ctx_cli_test_data() + [":ctx"],
    deps = all_crate_deps(
        normal = True,
        normal_dev = True,
    ) + CTX_CLI_TEST_DEPS,
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    rustc_env = COMMON_RUSTC_ENV,
    rustc_env_files = [":cargo_toml_env_vars"],
    rustc_flags = CTX_CLI_RUSTC_FLAGS,
    env = {
        "CARGO_BIN_EXE_ctx": "$(rootpath :ctx)",
    },
    tags = ["exclusive"],
)

