load("@crates//:defs.bzl", "aliases", "all_crate_deps", "crate_edition")
load("@rules_rust//cargo:defs.bzl", "cargo_toml_env_vars")
load("//:rust_sources.bzl", "RUST_PROD_SRC_EXCLUDES")
load("//tools/bazel:ctx_rust.bzl", "ctx_rust_binary", "ctx_rust_test")
load("//tools/bazel:gates.bzl", "loc_check_inputs")
load(":test_targets.bzl", "CTX_CLI_RUSTC_FLAGS", "ctx_cli_integration_test", "ctx_cli_test_data")

package(default_visibility = ["//visibility:public"])

loc_check_inputs(name = "loc_check_inputs")

exports_files([
    "BUILD.bazel",
    "Cargo.toml",
    "build.rs",
    "test_targets.bzl",
])

filegroup(
    name = "cargo_package_data",
    srcs = glob(["**"], exclude = ["BUILD.bazel"]),
)

filegroup(
    name = "native_dispatch_source",
    srcs = ["src/commands/import/native/dispatch.rs"],
)

filegroup(
    name = "provider_import_architecture_sources",
    srcs = glob(
        ["src/commands/import/**/*.rs"],
        exclude = RUST_PROD_SRC_EXCLUDES,
    ),
)

cargo_toml_env_vars(
    name = "cargo_toml_env_vars",
    src = "Cargo.toml",
)

COMMON_RUSTC_ENV = {
    "CARGO_MANIFEST_DIR": "crates/ctx-cli",
}

RELEASE_BUILD_RUSTC_ENV = select({
    "//tools/bazel/platforms:aarch64-apple-darwin": dict(
        COMMON_RUSTC_ENV,
        CTX_RELEASE_BUILD_TARGET = "aarch64-apple-darwin",
    ),
    "//tools/bazel/platforms:aarch64-unknown-linux-gnu": dict(
        COMMON_RUSTC_ENV,
        CTX_RELEASE_BUILD_TARGET = "aarch64-unknown-linux-gnu",
    ),
    "//tools/bazel/platforms:x86_64-apple-darwin": dict(
        COMMON_RUSTC_ENV,
        CTX_RELEASE_BUILD_TARGET = "x86_64-apple-darwin",
    ),
    "//tools/bazel/platforms:x86_64-pc-windows-gnu": dict(
        COMMON_RUSTC_ENV,
        CTX_RELEASE_BUILD_TARGET = "x86_64-pc-windows-gnu",
    ),
    "//tools/bazel/platforms:x86_64-unknown-freebsd": dict(
        COMMON_RUSTC_ENV,
        CTX_RELEASE_BUILD_TARGET = "x86_64-unknown-freebsd",
    ),
    "//tools/bazel/platforms:x86_64-unknown-linux-gnu": dict(
        COMMON_RUSTC_ENV,
        CTX_RELEASE_BUILD_TARGET = "x86_64-unknown-linux-gnu",
    ),
    "//conditions:default": dict(
        COMMON_RUSTC_ENV,
        CTX_RELEASE_BUILD_TARGET = "unselected",
    ),
})

CTX_CLI_DEPS = [
    "//crates/ctx-history-capture:lib",
    "//crates/ctx-history-core:lib",
    "//crates/ctx-history-search:lib",
    "//crates/ctx-history-store:lib",
    "//crates/ctx-pro-host-protocol:lib",
]

CTX_CLI_COMPILE_DATA = [
    "//:ctx_bundled_skills",
    "//:ctx_embedded_docs",
]

CTX_CLI_TEST_COMPILE_DATA = CTX_CLI_COMPILE_DATA + glob(["testdata/**"]) + [
    "//:release_contracts",
    "//:telemetry_contract_fixtures",
    "//crates/ctx-pro-host-protocol:testdata/v1/public-journal-page.json",
]

RUST_SRCS = glob(["src/**/*.rs"])

PROD_SRCS = glob(
    ["src/**/*.rs"],
    exclude = RUST_PROD_SRC_EXCLUDES,
)

ctx_rust_binary(
    name = "ctx",
    srcs = PROD_SRCS,
    crate_name = "ctx",
    crate_root = "src/main.rs",
    edition = crate_edition(),
    aliases = aliases(),
    compile_data = CTX_CLI_COMPILE_DATA,
    deps = all_crate_deps(normal = True) + CTX_CLI_DEPS,
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_env = RELEASE_BUILD_RUSTC_ENV,
    rustc_env_files = [
        ":cargo_toml_env_vars",
        "release-stamp.env",
    ],
    rustc_flags = CTX_CLI_RUSTC_FLAGS,
    stamp = -1,
)

# This target is the only non-test host allowed to select an unpublished local
# Pro helper. It remains testonly so no release graph can depend on it.
ctx_rust_binary(
    name = "ctx_pro_qualification",
    testonly = True,
    srcs = PROD_SRCS,
    crate_name = "ctx_pro_qualification",
    crate_root = "src/main.rs",
    edition = crate_edition(),
    aliases = aliases(),
    compile_data = CTX_CLI_COMPILE_DATA,
    deps = all_crate_deps(normal = True) + CTX_CLI_DEPS,
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_env = RELEASE_BUILD_RUSTC_ENV,
    rustc_env_files = [
        ":cargo_toml_env_vars",
        "release-stamp.env",
    ],
    rustc_flags = CTX_CLI_RUSTC_FLAGS + ["--cfg=ctx_pro_qualification"],
    stamp = -1,
    tags = ["manual", "qualification"],
)

# Optimized Pro protocol tests need a local helper authority that ordinary
# binaries intentionally compile out. Keep it in this test-only host.
ctx_rust_binary(
    name = "ctx_pro_test_host",
    testonly = True,
    srcs = PROD_SRCS,
    crate_name = "ctx_pro_test_host",
    crate_root = "src/main.rs",
    edition = crate_edition(),
    aliases = aliases(),
    compile_data = CTX_CLI_COMPILE_DATA,
    deps = all_crate_deps(normal = True) + CTX_CLI_DEPS,
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_env = RELEASE_BUILD_RUSTC_ENV,
    rustc_env_files = [
        ":cargo_toml_env_vars",
        "release-stamp.env",
    ],
    rustc_flags = CTX_CLI_RUSTC_FLAGS + ["--cfg=ctx_pro_test_helper"],
    stamp = -1,
)

# The auto-upgrade acceptance harness needs its deterministic crash and pause
# seams even when the surrounding release gate uses optimized compilation.
# Keep that authority in a test-only executable rather than enabling test hooks
# in the published release binary.
ctx_rust_binary(
    name = "ctx_auto_upgrade_acceptance_fixture",
    testonly = True,
    srcs = PROD_SRCS,
    crate_name = "ctx_auto_upgrade_acceptance_fixture",
    crate_root = "src/main.rs",
    edition = crate_edition(),
    aliases = aliases(),
    compile_data = CTX_CLI_COMPILE_DATA,
    deps = all_crate_deps(normal = True) + CTX_CLI_DEPS,
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_env = RELEASE_BUILD_RUSTC_ENV,
    rustc_env_files = [
        ":cargo_toml_env_vars",
        "release-stamp.env",
    ],
    rustc_flags = CTX_CLI_RUSTC_FLAGS + ["-Cdebug-assertions=yes"],
    stamp = -1,
)

ctx_rust_binary(
    name = "ctx_upgrade_test_harness",
    testonly = True,
    srcs = PROD_SRCS,
    crate_name = "ctx",
    crate_root = "src/main.rs",
    edition = crate_edition(),
    aliases = aliases(),
    compile_data = CTX_CLI_COMPILE_DATA,
    deps = all_crate_deps(normal = True) + CTX_CLI_DEPS,
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_env = RELEASE_BUILD_RUSTC_ENV,
    rustc_env_files = [
        ":cargo_toml_env_vars",
        "release-stamp.env",
        "src/upgrade/test-harness.env",
    ],
    rustc_flags = CTX_CLI_RUSTC_FLAGS,
    stamp = -1,
)

ctx_rust_test(
    name = "unit_tests",
    srcs = RUST_SRCS,
    crate_name = "ctx",
    crate_root = "src/main.rs",
    edition = crate_edition(),
    aliases = aliases(
        normal_dev = True,
        proc_macro_dev = True,
    ),
    compile_data = CTX_CLI_TEST_COMPILE_DATA,
    data = ctx_cli_test_data(),
    deps = all_crate_deps(
        normal = True,
        normal_dev = True,
    ) + CTX_CLI_DEPS,
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    rustc_env = COMMON_RUSTC_ENV,
    rustc_env_files = [":cargo_toml_env_vars"],
    rustc_flags = CTX_CLI_RUSTC_FLAGS,
    tags = ["exclusive"],
)

