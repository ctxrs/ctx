    edition = crate_edition(),
    aliases = aliases(),
    compile_data = CTX_CLI_COMPILE_DATA,
    deps = all_crate_deps(normal = True) + CTX_CLI_DEPS,
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_env = RELEASE_BUILD_RUSTC_ENV,
    rustc_env_files = [
        ":cargo_toml_env_vars",
        "release-stamp.env",
        "src/upgrade/test-harness.env",
    ],
    # Local metadata/signature/key injection exists only in this test-only
    # build capability. The published :ctx target cannot select it.
    rustc_flags = CTX_CLI_RUSTC_FLAGS + ["--cfg=ctx_release_qualification"],
    stamp = -1,
)

