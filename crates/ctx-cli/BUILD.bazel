load(":test_targets.bzl", "CTX_CLI_RUSTC_FLAGS", "ctx_cli_integration_test", "ctx_cli_test_data")

package(default_visibility = ["//visibility:public"])

exports_files([
    "BUILD.bazel",
    "Cargo.toml",
    "build.rs",
    "test_targets.bzl",
])

filegroup(
    name = "cargo_package_data",
    srcs = glob(["**"], exclude = ["BUILD.bazel"]),
)

filegroup(
    name = "integration_test_compile_data",
    srcs = glob(["tests/fixtures/**"], allow_empty = True),
)

filegroup(
    name = "integration_test_data",
    srcs = glob(["tests/fixtures/**"], allow_empty = True),
)

filegroup(
    name = "provider_import_architecture_sources",
    srcs = glob(
        ["src/commands/import/**/*.rs"],
        exclude = RUST_PROD_SRC_EXCLUDES,
    ),
)

cargo_toml_env_vars(
    name = "cargo_toml_env_vars",
    src = "Cargo.toml",
    workspace = "//:Cargo.toml",
)

