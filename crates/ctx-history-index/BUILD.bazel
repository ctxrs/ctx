load("@crates//:defs.bzl", "aliases", "all_crate_deps", "crate_edition")
load("@rules_rust//rust:defs.bzl", "rust_doc_test", "rust_library")
load("//:rust_sources.bzl", "RUST_PROD_SRC_EXCLUDES")
load("//tools/bazel:ctx_rust.bzl", "ctx_rust_test")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "cargo_package_data",
    srcs = glob(["**"], exclude = ["BUILD.bazel"]),
)

filegroup(
    name = "predecessor_fixture",
    srcs = glob(["testdata/pred/**"]),
)

COMMON_RUSTC_ENV = {
    "CARGO_MANIFEST_DIR": "crates/ctx-history-index",
}

RUST_SRCS = glob(["src/**/*.rs"])
RUST_TEST_SRCS = RUST_SRCS

PROD_SRCS = glob(
    ["src/**/*.rs"],
    exclude = RUST_PROD_SRC_EXCLUDES,
)

CTX_HISTORY_INDEX_DEPS = [
    "//crates/ctx-history-core:lib",
    "//crates/ctx-history-index-format:lib",
    "//crates/ctx-history-index-generation:lib",
    "//crates/ctx-history-index-query:lib",
    "//crates/ctx-history-platform:lib",
    "//crates/ctx-semantic-model:lib",
]

CTX_HISTORY_INDEX_TEST_DEPS = [
    "//crates/ctx-history-core:lib",
    "//crates/ctx-history-index-format:test_support_lib",
    "//crates/ctx-history-index-generation:test_support_lib",
    "//crates/ctx-history-index-query:test_support_lib",
    "//crates/ctx-history-platform:lib",
    "//crates/ctx-semantic-model:lib",
]

rust_library(
    name = "lib",
    srcs = PROD_SRCS,
    crate_name = "ctx_history_index",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    aliases = aliases(),
    deps = all_crate_deps(normal = True) + CTX_HISTORY_INDEX_DEPS,
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_env = COMMON_RUSTC_ENV,
)

rust_library(
    name = "test_support_lib",
    testonly = True,
    srcs = PROD_SRCS,
    crate_name = "ctx_history_index",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = all_crate_deps(normal = True, normal_dev = True) + CTX_HISTORY_INDEX_TEST_DEPS,
    proc_macro_deps = all_crate_deps(proc_macro = True, proc_macro_dev = True),
    rustc_env = COMMON_RUSTC_ENV,
    rustc_flags = ['--cfg=feature="test-support"'],
)

# The feature-enabled library is intentional: these compile-fail contracts
# exercise the maximal shippable Cargo feature surface.
rust_doc_test(
    name = "publication_seal_doc_tests",
    crate = ":test_support_lib",
)

ctx_rust_test(
    name = "unit_tests",
    srcs = RUST_TEST_SRCS,
    crate_name = "ctx_history_index",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    aliases = aliases(
        normal_dev = True,
        proc_macro_dev = True,
    ),
    data = [":predecessor_fixture"],
    deps = all_crate_deps(
        normal = True,
        normal_dev = True,
    ) + CTX_HISTORY_INDEX_TEST_DEPS,
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    rustc_env = COMMON_RUSTC_ENV,
)

ctx_rust_test(
    name = "republish_fault_tests",
    srcs = RUST_TEST_SRCS,
    crate_name = "ctx_history_index_republish_faults",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    aliases = aliases(
        normal_dev = True,
        proc_macro_dev = True,
    ),
    args = ["subprocess_"],
    data = [":predecessor_fixture"],
    deps = all_crate_deps(
        normal = True,
        normal_dev = True,
    ) + CTX_HISTORY_INDEX_TEST_DEPS,
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    rustc_env = COMMON_RUSTC_ENV,
    tags = [
        "fault-injection",
        "republish",
        "safe-presubmit",
    ],
)

ctx_rust_test(
    name = "session_authority_high_cardinality_tests",
    srcs = RUST_TEST_SRCS,
    crate_name = "ctx_history_index_session_authority_high_cardinality",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    aliases = aliases(
        normal_dev = True,
        proc_macro_dev = True,
    ),
    args = [
        "--ignored",
        "--exact",
        "tests::writer::complexity_contract::high_cardinality_same_session_append_reads_only_the_live_witness",
        "--nocapture",
        "--test-threads=1",
    ],
    deps = all_crate_deps(
        normal = True,
        normal_dev = True,
    ) + CTX_HISTORY_INDEX_TEST_DEPS,
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    rustc_env = COMMON_RUSTC_ENV,
    tags = ["tier-nightly"],
    timeout = "long",
)

# Raw controlled-host measurement. Pair and analyze its output outside the test;
# this target owns no benchmark classifier, scheduler, or report format.
ctx_rust_test(
    name = "republish_raw_measurement",
    srcs = RUST_TEST_SRCS,
    crate_name = "ctx_history_index_republish_raw_measurement",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    aliases = aliases(
        normal_dev = True,
        proc_macro_dev = True,
    ),
    args = [
        "--ignored",
        "--exact",
        "tests::republish_qualification::controlled_host_measurement",
        "--nocapture",
        "--test-threads=1",
    ],
    deps = all_crate_deps(
        normal = True,
        normal_dev = True,
    ) + CTX_HISTORY_INDEX_TEST_DEPS,
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    rustc_env = COMMON_RUSTC_ENV,
    size = "large",
    tags = [
        "linux-only",
        "manual",
        "republish",
        "no-cache",
        "release",
    ],
    target_compatible_with = ["@platforms//os:linux"],
    timeout = "long",
)
