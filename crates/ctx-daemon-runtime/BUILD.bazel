load("@crates//:defs.bzl", "aliases", "all_crate_deps", "crate_edition")
load("@rules_rust//rust:defs.bzl", "rust_library")
load("//:rust_sources.bzl", "RUST_PROD_SRC_EXCLUDES")
load("//tools/bazel:ctx_rust.bzl", "ctx_rust_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "BUILD.bazel",
    "Cargo.toml",
    "build.rs",
])

filegroup(
    name = "cargo_package_data",
    srcs = glob(["**"], exclude = ["BUILD.bazel"]),
)

LAUNCHER_DATA = select({
    "@platforms//os:windows": ["//crates/ctx-task-launcher:ctx-task-launcher"],
    "//conditions:default": [],
})

COMMON_RUSTC_ENV = select({
    "@platforms//os:windows": {
        "CARGO_MANIFEST_DIR": "crates/ctx-daemon-runtime",
        "CTX_TASK_LAUNCHER": "$(execpath //crates/ctx-task-launcher:ctx-task-launcher)",
    },
    "//conditions:default": {
        "CARGO_MANIFEST_DIR": "crates/ctx-daemon-runtime",
    },
})

RUST_SRCS = glob(["src/**/*.rs"])

PROD_SRCS = glob(
    ["src/**/*.rs"],
    exclude = RUST_PROD_SRC_EXCLUDES,
)

CTX_DAEMON_RUNTIME_DEPS = [
    "//crates/ctx-history-core:lib",
    "//crates/ctx-history-platform:lib",
]

CTX_DAEMON_RUNTIME_RUSTC_FLAGS = [
    "--check-cfg=cfg(ctx_release_qualification)",
    "--check-cfg=cfg(test)",
]

rust_library(
    name = "lib",
    compile_data = LAUNCHER_DATA,
    srcs = PROD_SRCS,
    crate_name = "ctx_daemon_runtime",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    aliases = aliases(),
    deps = all_crate_deps(normal = True) + CTX_DAEMON_RUNTIME_DEPS,
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_env = COMMON_RUSTC_ENV,
    rustc_flags = CTX_DAEMON_RUNTIME_RUSTC_FLAGS,
)

rust_library(
    name = "qualification_lib",
    compile_data = LAUNCHER_DATA,
    testonly = True,
    srcs = PROD_SRCS,
    crate_name = "ctx_daemon_runtime",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    aliases = aliases(),
    deps = all_crate_deps(normal = True) + CTX_DAEMON_RUNTIME_DEPS,
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_env = COMMON_RUSTC_ENV,
    rustc_flags = CTX_DAEMON_RUNTIME_RUSTC_FLAGS + ["--cfg=ctx_release_qualification"],
)

ctx_rust_test(
    name = "unit_tests",
    compile_data = LAUNCHER_DATA,
    srcs = RUST_SRCS,
    crate_name = "ctx_daemon_runtime",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = all_crate_deps(normal = True, normal_dev = True) + CTX_DAEMON_RUNTIME_DEPS,
    proc_macro_deps = all_crate_deps(proc_macro = True, proc_macro_dev = True),
    rustc_env = COMMON_RUSTC_ENV,
    rustc_flags = CTX_DAEMON_RUNTIME_RUSTC_FLAGS,
)
