load("@crates//:defs.bzl", "aliases", "all_crate_deps", "crate_edition")
load("@rules_rust//rust:defs.bzl", "rust_library")
load("//:rust_sources.bzl", "RUST_PROD_SRC_EXCLUDES")
load("//tools/bazel:ctx_rust.bzl", "ctx_rust_test")
load(":test_targets.bzl", "history_read_binary_contract")

package(default_visibility = ["//visibility:public"])

exports_files([
    "BUILD.bazel",
    "Cargo.toml",
    "test_targets.bzl",
])

filegroup(
    name = "cargo_package_data",
    srcs = glob(["**"], exclude = ["BUILD.bazel"]),
)

COMMON_RUSTC_ENV = {
    "CARGO_MANIFEST_DIR": "crates/ctx-history-read-application",
}

RUST_SRCS = glob(["src/**/*.rs"])
PROD_SRCS = glob(["src/**/*.rs"], exclude = RUST_PROD_SRC_EXCLUDES)

APPLICATION_DEPS = [
    "//crates/ctx-history-core:lib",
    "//crates/ctx-history-index-format:lib",
    "//crates/ctx-history-index-query:lib",
]

APPLICATION_TEST_DEPS = [
    "//crates/ctx-history-core:lib",
    "//crates/ctx-history-index-format:lib",
    "//crates/ctx-history-index-query:test_support_lib",
    "//crates/ctx-history-index:lib",
]

rust_library(
    name = "lib",
    srcs = PROD_SRCS,
    crate_name = "ctx_history_read_application",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    aliases = aliases(),
    deps = all_crate_deps(normal = True) + APPLICATION_DEPS,
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_env = COMMON_RUSTC_ENV,
)

ctx_rust_test(
    name = "unit_tests",
    srcs = RUST_SRCS,
    crate_name = "ctx_history_read_application",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = all_crate_deps(normal = True, normal_dev = True) + APPLICATION_TEST_DEPS,
    proc_macro_deps = all_crate_deps(proc_macro = True, proc_macro_dev = True),
    rustc_env = COMMON_RUSTC_ENV,
)

history_read_binary_contract(
    name = "search_refresh_tests",
    src = "tests/contracts/search_refresh.rs",
    extra_deps = [
        "//crates/ctx-history-core:lib",
        "//crates/ctx-history-platform:lib",
    ],
    extra_env = {"RUST_TEST_THREADS": "1"},
    extra_srcs = [
        "tests/support/search_refresh/core_behaviors.rs",
        "tests/support/search_refresh/generation_lifecycle.rs",
    ],
)

history_read_binary_contract(
    name = "search_source_identity_filters_tests",
    src = "tests/contracts/search_source_identity_filters.rs",
    tags = ["cli-contract"],
)

history_read_binary_contract(
    name = "search_show_tests",
    src = "tests/contracts/search_show.rs",
    extra_srcs = [
        "tests/support/search_show/import_paths.rs",
        "tests/support/search_show/pi_flow.rs",
        "tests/support/search_show/search_filters.rs",
        "tests/support/search_show/search_flows.rs",
    ],
)
