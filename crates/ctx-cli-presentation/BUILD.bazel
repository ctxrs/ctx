load("@crates//:defs.bzl", "aliases", "all_crate_deps", "crate_edition")
load("@rules_rust//rust:defs.bzl", "rust_library")
load("//:rust_sources.bzl", "RUST_PROD_SRC_EXCLUDES")
load("//tools/bazel:ctx_rust.bzl", "ctx_rust_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "BUILD.bazel",
    "Cargo.toml",
])

filegroup(
    name = "cargo_package_data",
    srcs = glob(["**"], exclude = ["BUILD.bazel"]),
)

COMMON_RUSTC_ENV = {
    "CARGO_MANIFEST_DIR": "crates/ctx-cli-presentation",
}

CTX_CLI_PRESENTATION_DEPS = [
    "//crates/ctx-agent-application:lib",
    "//crates/ctx-agent-integrations:lib",
    "//crates/ctx-client-observability:lib",
    "//crates/ctx-history-cli:lib",
    "//crates/ctx-history-core:lib",
    "//crates/ctx-history-read-application:lib",
    "//crates/ctx-history-refresh:lib",
    "//crates/ctx-terminal:lib",
    "//crates/ctx-upgrade-engine:lib",
]

CTX_CLI_PRESENTATION_TEST_SUPPORT_DEPS = [
    "//crates/ctx-agent-application:test_support_lib",
    "//crates/ctx-agent-integrations:test_support_lib",
    "//crates/ctx-client-observability:test_support_lib",
    "//crates/ctx-history-cli:test_support_lib",
    "//crates/ctx-history-core:lib",
    "//crates/ctx-history-read-application:lib",
    "//crates/ctx-history-refresh:test_support_lib",
    "//crates/ctx-terminal:lib",
    "//crates/ctx-upgrade-engine:test_support_lib",
]

CTX_CLI_PRESENTATION_QUALIFICATION_DEPS = [
    "//crates/ctx-agent-application:lib",
    "//crates/ctx-agent-integrations:lib",
    "//crates/ctx-client-observability:lib",
    "//crates/ctx-history-cli:lib",
    "//crates/ctx-history-core:lib",
    "//crates/ctx-history-read-application:lib",
    "//crates/ctx-history-refresh:lib",
    "//crates/ctx-terminal:lib",
    "//crates/ctx-upgrade-engine:qualification_lib",
]

RUST_SRCS = glob(["src/**/*.rs"])

PROD_SRCS = glob(
    ["src/**/*.rs"],
    exclude = RUST_PROD_SRC_EXCLUDES,
)

rust_library(
    name = "lib",
    srcs = PROD_SRCS,
    crate_name = "ctx_cli_presentation",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    aliases = aliases(),
    deps = all_crate_deps(normal = True) + CTX_CLI_PRESENTATION_DEPS,
    proc_macro_deps = all_crate_deps(proc_macro = True),
    compile_data = ["//:ctx_embedded_docs"],
    rustc_env = COMMON_RUSTC_ENV,
)

rust_library(
    name = "test_support_lib",
    testonly = True,
    srcs = PROD_SRCS,
    crate_name = "ctx_cli_presentation",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    aliases = aliases(),
    deps = all_crate_deps(normal = True) + CTX_CLI_PRESENTATION_TEST_SUPPORT_DEPS,
    proc_macro_deps = all_crate_deps(proc_macro = True),
    compile_data = ["//:ctx_embedded_docs"],
    rustc_env = COMMON_RUSTC_ENV,
)

rust_library(
    name = "qualification_lib",
    testonly = True,
    srcs = PROD_SRCS,
    crate_name = "ctx_cli_presentation",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    aliases = aliases(),
    deps = all_crate_deps(normal = True) + CTX_CLI_PRESENTATION_QUALIFICATION_DEPS,
    proc_macro_deps = all_crate_deps(proc_macro = True),
    compile_data = ["//:ctx_embedded_docs"],
    rustc_env = COMMON_RUSTC_ENV,
)

ctx_rust_test(
    name = "unit_tests",
    srcs = RUST_SRCS,
    crate_name = "ctx_cli_presentation",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = all_crate_deps(normal = True, normal_dev = True) + CTX_CLI_PRESENTATION_TEST_SUPPORT_DEPS,
    proc_macro_deps = all_crate_deps(proc_macro = True, proc_macro_dev = True),
    compile_data = ["//:ctx_embedded_docs"],
    rustc_env = COMMON_RUSTC_ENV,
)
