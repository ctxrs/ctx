load("@crates//:defs.bzl", "aliases", "all_crate_deps", "crate_edition")
load("@rules_rust//cargo:defs.bzl", "cargo_toml_env_vars")
load("@rules_rust//rust:defs.bzl", "rust_library")
load("//:rust_sources.bzl", "RUST_PROD_SRC_EXCLUDES")
load("//tools/bazel:binary_contracts.bzl", "ctx_binary_contract_test")
load("//tools/bazel:ctx_rust.bzl", "ctx_rust_test")

package(default_visibility = ["//visibility:public"])

exports_files(["BUILD.bazel", "Cargo.toml"])

filegroup(
    name = "cargo_package_data",
    srcs = glob(["**"], exclude = ["BUILD.bazel"]),
)

COMMON_RUSTC_ENV = {
    "CARGO_MANIFEST_DIR": "crates/ctx-graph",
}

cargo_toml_env_vars(
    name = "cargo_toml_env_vars",
    src = "Cargo.toml",
    workspace = "//:Cargo.toml",
)

RUST_SRCS = glob(["src/**/*.rs"])
PROD_SRCS = glob(["src/**/*.rs"], exclude = RUST_PROD_SRC_EXCLUDES)

rust_library(
    name = "lib",
    srcs = PROD_SRCS,
    crate_name = "ctx_graph",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    aliases = aliases(),
    deps = ["//crates/ctx-graph-core:lib"] + all_crate_deps(normal = True),
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_env = COMMON_RUSTC_ENV,
    rustc_env_files = [":cargo_toml_env_vars"],
)

ctx_rust_test(
    name = "unit_tests",
    srcs = RUST_SRCS,
    crate_name = "ctx_graph",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = ["//crates/ctx-graph-core:lib"] + all_crate_deps(normal = True, normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro = True, proc_macro_dev = True),
    rustc_env = COMMON_RUSTC_ENV,
    rustc_env_files = [":cargo_toml_env_vars"],
)

ctx_binary_contract_test(
    name = "cli_tests",
    src = "tests/cli.rs",
    binary = "//crates/ctx-cli:ctx",
    cargo_manifest_dir = "crates/ctx-graph",
    extra_compile_data = glob(["tests/fixtures/**"]),
    extra_crates = ["rusqlite", "serde_json", "tempfile"],
    extra_deps = ["//crates/ctx-graph-core:lib"],
    rustc_env_files = [":cargo_toml_env_vars"],
)
