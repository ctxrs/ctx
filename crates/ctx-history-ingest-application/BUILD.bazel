load("@crates//:defs.bzl", "aliases", "all_crate_deps", "crate_edition")
load("@rules_rust//rust:defs.bzl", "rust_library")
load("//:rust_sources.bzl", "RUST_PROD_SRC_EXCLUDES")
load("//tools/bazel:ctx_rust.bzl", "ctx_rust_test")
load(":test_targets.bzl", "history_ingest_binary_contract")

package(default_visibility = ["//visibility:public"])

exports_files([
    "BUILD.bazel",
    "Cargo.toml",
    "test_targets.bzl",
])

filegroup(
    name = "cargo_package_data",
    srcs = glob(["**"], exclude = ["BUILD.bazel"]),
)

COMMON_RUSTC_ENV = {"CARGO_MANIFEST_DIR": "crates/ctx-history-ingest-application"}
RUST_SRCS = glob(["src/**/*.rs"])
PROD_SRCS = glob(["src/**/*.rs"], exclude = RUST_PROD_SRC_EXCLUDES)

INGEST_APPLICATION_DEPS = [
    "//crates/ctx-history-capture-model:lib",
    "//crates/ctx-history-core:lib",
    "//crates/ctx-history-source-discovery:lib",
    "//crates/ctx-history-source-io:lib",
]

INGEST_APPLICATION_PROD_DEPS = INGEST_APPLICATION_DEPS + ["//crates/ctx-history-refresh:lib"]
INGEST_APPLICATION_TEST_DEPS = INGEST_APPLICATION_DEPS + ["//crates/ctx-history-refresh:test_support_lib"]

rust_library(
    name = "lib",
    srcs = PROD_SRCS,
    crate_name = "ctx_history_ingest_application",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    aliases = aliases(),
    deps = all_crate_deps(normal = True) + INGEST_APPLICATION_PROD_DEPS,
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_env = COMMON_RUSTC_ENV,
)

rust_library(
    name = "qualification_lib",
    testonly = True,
    srcs = PROD_SRCS,
    crate_name = "ctx_history_ingest_application",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    aliases = aliases(),
    deps = all_crate_deps(normal = True) + INGEST_APPLICATION_PROD_DEPS,
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_env = COMMON_RUSTC_ENV,
)

rust_library(
    name = "test_support_lib",
    testonly = True,
    srcs = PROD_SRCS,
    crate_name = "ctx_history_ingest_application",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    aliases = aliases(),
    deps = all_crate_deps(normal = True) + INGEST_APPLICATION_TEST_DEPS,
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_env = COMMON_RUSTC_ENV,
)

ctx_rust_test(
    name = "unit_tests",
    srcs = RUST_SRCS,
    crate_name = "ctx_history_ingest_application",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = all_crate_deps(normal = True, normal_dev = True) + INGEST_APPLICATION_TEST_DEPS,
    proc_macro_deps = all_crate_deps(proc_macro = True, proc_macro_dev = True),
    rustc_env = COMMON_RUSTC_ENV,
)

history_ingest_binary_contract(
    name = "custom_root_discovery_tests",
    src = "tests/contracts/custom_root_discovery.rs",
    extra_srcs = ["tests/contracts/custom_root_discovery/import_failures.rs"],
)

history_ingest_binary_contract(
    name = "explicit_path_revision_upgrade_tests",
    src = "tests/contracts/explicit_path_revision_upgrade.rs",
)

history_ingest_binary_contract(
    name = "history_source_plugins_tests",
    src = "tests/contracts/history_source_plugins.rs",
)

history_ingest_binary_contract(
    name = "import_change_reporting_tests",
    src = "tests/contracts/import_change_reporting.rs",
)

history_ingest_binary_contract(
    name = "self_contained_core_content_tests",
    src = "tests/contracts/self_contained_core_content.rs",
)
