load("@crates//:defs.bzl", "aliases", "all_crate_deps", "crate_edition")
load("@rules_rust//rust:defs.bzl", "rust_library")
load("//:rust_sources.bzl", "RUST_PROD_SRC_EXCLUDES")
load("//tools/bazel:ctx_rust.bzl", "ctx_rust_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "BUILD.bazel",
    "Cargo.toml",
])

filegroup(
    name = "cargo_package_data",
    srcs = glob(["**"], exclude = ["BUILD.bazel"]),
)

COMMON_RUSTC_ENV = {
    "CARGO_MANIFEST_DIR": "crates/ctx-history-cli",
}

HISTORY_CLI_DEPS = [
    "//crates/ctx-history-capture:lib",
    "//crates/ctx-history-core:lib",
    "//crates/ctx-history-platform:lib",
    "//crates/ctx-history-ingest-application:lib",
    "//crates/ctx-history-index:lib",
    "//crates/ctx-history-read-application:lib",
    "//crates/ctx-history-refresh:lib",
    "//crates/ctx-daemon-cli:lib",
    "//crates/ctx-client-observability:lib",
    "//crates/ctx-terminal:lib",
]

HISTORY_CLI_TEST_SUPPORT_DEPS = [
    "//crates/ctx-history-capture:lib",
    "//crates/ctx-history-core:lib",
    "//crates/ctx-history-platform:lib",
    "//crates/ctx-history-ingest-application:test_support_lib",
    "//crates/ctx-history-index:lib",
    "//crates/ctx-history-read-application:lib",
    "//crates/ctx-history-refresh:test_support_lib",
    "//crates/ctx-daemon-cli:test_support_lib",
    "//crates/ctx-client-observability:test_support_lib",
    "//crates/ctx-terminal:lib",
]

# Concrete semantic projection is used only by the API/renderer unit fixture.
HISTORY_CLI_UNIT_TEST_DEPS = [
    "//crates/ctx-semantic-index:lib",
]

RUST_SRCS = glob(["src/**/*.rs"])

PROD_SRCS = glob(
    ["src/**/*.rs"],
    exclude = RUST_PROD_SRC_EXCLUDES,
)

rust_library(
    name = "lib",
    srcs = PROD_SRCS,
    crate_name = "ctx_history_cli",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    aliases = aliases(),
    deps = all_crate_deps(normal = True) + HISTORY_CLI_DEPS,
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_env = COMMON_RUSTC_ENV,
)

rust_library(
    name = "test_support_lib",
    testonly = True,
    srcs = PROD_SRCS,
    crate_name = "ctx_history_cli",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    aliases = aliases(),
    deps = all_crate_deps(normal = True) + HISTORY_CLI_TEST_SUPPORT_DEPS,
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_env = COMMON_RUSTC_ENV,
)

ctx_rust_test(
    name = "unit_tests",
    srcs = RUST_SRCS,
    crate_name = "ctx_history_cli",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = all_crate_deps(normal = True, normal_dev = True) + HISTORY_CLI_DEPS + HISTORY_CLI_UNIT_TEST_DEPS,
    proc_macro_deps = all_crate_deps(proc_macro = True, proc_macro_dev = True),
    compile_data = glob(["src/source_index/render/goldens/*.txt"]),
    rustc_env = COMMON_RUSTC_ENV,
)

ctx_rust_test(
    name = "request_parity_tests",
    srcs = ["tests/request_parity.rs"],
    crate_name = "request_parity_tests",
    crate_root = "tests/request_parity.rs",
    edition = crate_edition(),
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = all_crate_deps(normal = True, normal_dev = True) + HISTORY_CLI_DEPS + [
        "//crates/ctx-history-cli:lib",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True, proc_macro_dev = True),
    rustc_env = COMMON_RUSTC_ENV,
)
