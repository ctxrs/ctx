# repository_set also emits a target toolchain for its execution triple. Give
# that MSVC target the opposite ABI constraint so it cannot match the GNU
# release platform while the shared route setting is enabled.
rust.repository_set(
    name = "ctx_windows_gnu",
    target_compatible_with = [
        "//tools/bazel/platforms:windows_msvc",
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
    ],
    target_triple = "x86_64-pc-windows-msvc",
)

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.annotation(
    # Share the macOS shutdown correction with the Cargo release factory.
    # Remove both applications when notify releases the lost-stop fix.
    crate = "notify",
    patch_args = ["-p1"],
    patches = ["//tools/bazel/patches:notify-fsevents-stop.patch"],
    repositories = ["crates"],
    version = "9.0.0-rc.4",
)
crate.annotation(
    # ort's generic ELF .fini_array cleanup runs too late on FreeBSD, after
    # ONNX Runtime's C++ teardown has started. Register ReleaseEnv after the
    # environment is created so it runs first, matching ort's macOS ordering.
    crate = "ort",
    patch_args = ["-p1"],
    patches = ["//tools/bazel/patches:ort-freebsd-release-env-order.patch"],
    repositories = ["crates"],
    version = "2.0.0-rc.12",
)
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    manifests = ["//:Cargo.toml"],
    # Preserve rules_rust's reduced defaults and add every shipped native host
    # that the upstream default intentionally omits.
    supported_platform_triples = [
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "wasm32-unknown-unknown",
        "wasm32-wasip1",
        "x86_64-apple-darwin",
        "x86_64-pc-windows-gnu",
        "x86_64-pc-windows-msvc",
        "x86_64-unknown-freebsd",
        "x86_64-unknown-linux-gnu",
        "x86_64-unknown-nixos-gnu",
    ],
)
crate.render_config(
    platforms_template = "@@//tools/bazel/platforms:{triple}",
    repositories = ["crates"],
)
use_repo(crate, "crates")

# Keep mutating Cargo repairs and dependency hygiene on repository-owned,
# reproducible binaries instead of whichever cargo subcommands happen to be
# installed on a developer machine. These tools are separate from the product
# dependency graph and therefore do not expand Cargo.lock or crate_universe's
# shipped Rust closure.
cargo_tools = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
cargo_tools.spec(
    package = "cargo-fixit",
    repositories = ["ctx_cargo_tools"],
    version = "=0.1.15",
)
cargo_tools.spec(
    package = "cargo-shear",
    repositories = ["ctx_cargo_tools"],
    version = "=1.13.4",
)
cargo_tools.annotation(
    crate = "cargo-fixit",
    gen_all_binaries = True,
    repositories = ["ctx_cargo_tools"],
)
cargo_tools.annotation(
    build_script_data = [
        "@@rules_rust++crate+ctx_cargo_tools__libssh2-sys-0.3.2//:libssh2/include/libssh2.h",
        "@@rules_rust++crate+ctx_cargo_tools__libssh2-sys-0.3.2//:libssh2/include/libssh2_publickey.h",
        "@@rules_rust++crate+ctx_cargo_tools__libssh2-sys-0.3.2//:libssh2/include/libssh2_sftp.h",
        "@@rules_rust++crate+ctx_cargo_tools__libz-sys-1.1.29//:src/zlib/zconf.h",
        "@@rules_rust++crate+ctx_cargo_tools__libz-sys-1.1.29//:src/zlib/zlib.h",
    ],
    crate = "libgit2-sys",
    patch_args = ["-p1"],
    patches = ["//tools/bazel/patches:libgit2-sys-bazel-headers.patch"],
    repositories = ["ctx_cargo_tools"],
    version = "0.18.8+1.9.7",
)
cargo_tools.annotation(
    # cargo-fixit uses git2 only to inspect the local worktree. Disable
    # libssh2's optional compression so this developer tool does not depend on
    # undeclared host zlib headers inside Bazel's hermetic sandbox.
    crate = "libssh2-sys",
    patch_args = ["-p1"],
    patches = ["//tools/bazel/patches:libssh2-sys-disable-zlib.patch"],
    repositories = ["ctx_cargo_tools"],
    version = "0.3.2",
)
cargo_tools.annotation(
    crate = "cargo-shear",
    gen_all_binaries = True,
    repositories = ["ctx_cargo_tools"],
)
cargo_tools.from_specs(name = "ctx_cargo_tools")
use_repo(cargo_tools, "ctx_cargo_tools")

