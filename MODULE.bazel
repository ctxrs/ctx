crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    manifests = ["//:Cargo.toml"],
    # Preserve rules_rust's reduced defaults and add the shipped macOS x64
    # target, which the upstream default intentionally omits.
    supported_platform_triples = [
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "wasm32-unknown-unknown",
        "wasm32-wasip1",
        "x86_64-apple-darwin",
        "x86_64-pc-windows-msvc",
        "x86_64-unknown-linux-gnu",
        "x86_64-unknown-nixos-gnu",
    ],
)
use_repo(crate, "crates")

# Development links use a content-pinned mold input. The public build macros
# expose it only through the Linux development configuration; CI/debug/release
# configurations retain their independently keyed linker behavior.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")
http_jar = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_jar")
http_jar(
    name = "ctx_bazel_diff",
    sha256 = "331fa4d5f220e99e727d3c9a4fd89a23fe27806f99c4788fa9fa233e350fef5f",
    urls = ["https://github.com/Tinder/bazel-diff/releases/download/v36.0.0/bazel-diff_deploy.jar"],
)
http_archive(
    name = "ctx_mold",
    build_file_content = """
package(default_visibility = ["//visibility:public"])
exports_files(["bin/mold", "bin/ld.mold"])
""",
    sha256 = "a3696680d99e692970590a178bc3a33d78d60d1c6dc9db7a11b557b02b751f5d",
    strip_prefix = "mold-2.41.0-x86_64-linux",
    urls = ["https://github.com/rui314/mold/releases/download/v2.41.0/mold-2.41.0-x86_64-linux.tar.gz"],
)
